# Percent change a gate row may move before it fails.
#
# The row's name picks the default: *_compile_ms uses `compile`, *_binary_bytes
# uses `binary`, *_run_ms uses `runtime`. Any other key is a per-row override
# in percent -- useful for a row that is honest but noisier than its kind.
#
# Compile time on shared CI runners moves 20-50% for the same compiler, so
# compile rows are tripwires for catastrophic regressions only: they are tracked
# in the baseline but never fail the gate on normal runner noise. The claims
# that are actually gated are the ratios (fib_compile_ratio and fib_wrap_ratio,
# gated at `ratio=20` here and asserted against their absolute bounds in
# ci.sh/ci.ps1) and the promotion count (promoted_sites == 1, asserted in the
# scripts), plus run-time rows within their percent.
compile=100
binary=10
runtime=20
# A same-run ratio is already normalised: its two halves were measured on the
# same runner, in the same run, interleaved. A 20% move in the ratio is a real
# regression rather than runner noise, so it is gated where a raw compile
# millisecond is not. This is the compile-time gate: the row is
# `fib_compile_ratio` (Yashy's compile of fib over clang's compile of fib.c).
ratio=20

# There is no `large_compile_ms` override any more: it was 25%, and the same
# run-to-run noise that makes 20% unusable for a small program made 25%
# unusable for the 1,000-line one. compile=100 covers every compile row.

# The C row is the denominator of `fib_wrap_ratio`, not a Yashy row: clang's own
# run time moving is not a regression in this compiler (and the runner is the
# same machine the Yashy rows are measured on, so drift is already visible
# there). The claim it feeds is asserted in ci.sh/ci.ps1.
fib_c_run_ms=100

# The same for two rows the ratio gate already owns. `hello_run_ms` is a few
# milliseconds, where 20% is less than the timer's own noise, and
# `fib_wrap_run_ms` is half of `fib_wrap_ratio`: the assertion there is the
# tighter instrument (1.20 including both rows), so this one gets room.
hello_run_ms=50
fib_wrap_run_ms=50

# `release_run_ms` is 1.5-6.5 ms: process start-up plus a program with no work
# in it. 20% of a 5 ms row is under one timer tick, so the row is a tripwire for
# a doubled cost, not a percentage gate. What the release link is actually held
# to is the PGO table (`scripts/pgo.sh`), which measures programs that do work.
release_run_ms=100
