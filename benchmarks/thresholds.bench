# Percent change a gate row may move before it fails.
#
# The row's name picks the default: *_compile_ms uses `compile`, *_binary_bytes
# uses `binary`, *_run_ms uses `runtime`. Any other key is a per-row override
# in percent -- useful for a row that is honest but noisier than its kind.

compile=20
binary=10
runtime=20

# The 1,000-line program is a slower build; give it a little more room than a
# small program, but still catch a real regression.
large_compile_ms=25

# The C row is the denominator of `fib_wrap_ratio`, not a Yashy row: clang's own
# run time moving is not a regression in this compiler (and the runner is the
# same machine the Yashy rows are measured on, so drift is already visible
# there). The claim it feeds is asserted in ci.sh/ci.ps1.
fib_c_run_ms=100

# The same for two rows the ratio gate already owns. `hello_run_ms` is a few
# milliseconds, where 20% is less than the timer's own noise, and
# `fib_wrap_run_ms` is half of `fib_wrap_ratio`: the assertion there is the
# tighter instrument (1.20 including both rows), so this one gets room.
hello_run_ms=50
fib_wrap_run_ms=50

# `release_run_ms` is 1.5-6.5 ms: process start-up plus a program with no work
# in it. 20% of a 5 ms row is under one timer tick, so the row is a tripwire for
# a doubled cost, not a percentage gate. What the release link is actually held
# to is the PGO table (`scripts/pgo.sh`), which measures programs that do work.
release_run_ms=100
