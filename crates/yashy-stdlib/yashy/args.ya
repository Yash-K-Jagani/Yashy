// Program arguments (phase 12, Task 10).
//
// `args()` is the builtin list of user arguments (the executable path is
// excluded); this module names the queries over it. An invocation with no
// arguments yields an empty list. `yashy run main.ya -- notes.txt` makes
// `nth(0)` answer `notes.txt`.
//
// A `for` loop borrows each element, so `nth` copies the element it wants
// before releasing the list; indexing a `[]string` would move the whole
// slice. `held` starts as `""` only because a `let` needs an initialiser --
// `found` gates it, so an empty argument and a missing one stay distinct.

/// The process's user arguments as a fresh owned `[]string`.
pub fn all() -> []string {
    return args();
}

/// The argument at `index`, or `None` outside `0..len()`.
///
/// The name is `nth`, not `get`, because every module's items share one root
/// scope: `env.get` already owns `get`, and two modules imported together may
/// not declare the same name.
pub fn nth(int index) -> Option[string] {
    if index < 0 {
        const Option[string] missing = None;
        return missing;
    }
    const arguments = args();
    let bool found = false;
    let string held = "";
    let at = 0;
    for argument in arguments {
        if at == index {
            held = argument.slice(0, argument.len());
            found = true;
        }
        at = at + 1;
    }
    arguments.free();
    if !found {
        const Option[string] missing = None;
        return missing;
    }
    return Some(held);
}

/// Whether `--name` appears in the arguments.
pub fn flag(string name) -> bool {
    const arguments = args();
    const wanted = "--${name}";
    let found = false;
    for argument in arguments {
        if argument == wanted {
            found = true;
        }
    }
    arguments.free();
    return found;
}
