// Semantic versions, including pre-release precedence.
//
// A version is major.minor.patch with an optional `-pre` and `+build`. Build
// metadata is stored and rendered but ignored for precedence, as SemVer 2.0
// requires. A malformed version answers `Err(Invalid)`, never a sentinel zero.

/// Why a text is not a version. The `int` is the byte offset of the first
/// problem in the input.
pub enum SemverError {
    Invalid(int),
}

/// A human-readable rendering of a version error with its byte offset.
pub fn describe_semver(SemverError error) -> string {
    return switch error {
        case Invalid(at) { "invalid version at byte ${at}" }
    };
}

/// A parsed version. `pre` and `build` are empty when absent.
pub struct Semver {
    major: int,
    minor: int,
    patch: int,
    pre: string,
    build: string,
}

/// Parse `major.minor.patch[-pre][+build]`.
pub fn parse_version(string text) -> Result[Semver, SemverError] {
    const plus = semver_find_from(text, "+", 0);
    let with_build = text;
    if plus >= 0 { with_build = text.slice(0, plus); }
    let build = "";
    if plus >= 0 { build = text.slice(plus + 1, text.len()); }
    if plus >= 0 && !valid_identifiers(build, false) {
        return Err(SemverError.Invalid(plus + 1));
    }

    const dash = semver_find_from(with_build, "-", 0);
    let core = with_build;
    if dash >= 0 { core = with_build.slice(0, dash); }
    let pre = "";
    if dash >= 0 { pre = with_build.slice(dash + 1, with_build.len()); }
    if dash >= 0 && !valid_identifiers(pre, true) {
        return Err(SemverError.Invalid(dash + 1));
    }

    // Locate the two dots rather than calling `split`: that builtin returns an
    // owned array which this total parser would have to release on every exit,
    // including the error paths below. Slices are views, so the three
    // components borrow `core` and own nothing.
    const first_dot = semver_find_from(core, ".", 0);
    if first_dot < 0 {
        return Err(SemverError.Invalid(core.len()));
    }
    const second_dot = semver_find_from(core, ".", first_dot + 1);
    if second_dot < 0 {
        return Err(SemverError.Invalid(first_dot + 1));
    }
    if semver_find_from(core, ".", second_dot + 1) >= 0 {
        return Err(SemverError.Invalid(second_dot + 1));
    }
    const string sa = core.slice(0, first_dot);
    const string sb = core.slice(first_dot + 1, second_dot);
    const string sc = core.slice(second_dot + 1, core.len());
    const Option[int] na = sa.parse_i64();
    const Option[int] nb = sb.parse_i64();
    const Option[int] nc = sc.parse_i64();
    if na is None || nb is None || nc is None {
        if na is None {
            return Err(SemverError.Invalid(0));
        }
        if nb is None {
            return Err(SemverError.Invalid(first_dot + 1));
        }
        return Err(SemverError.Invalid(second_dot + 1));
    }
    const int major = switch na { case Some(value) { value } case None { 0 } };
    const int minor = switch nb { case Some(value) { value } case None { 0 } };
    const int patch = switch nc { case Some(value) { value } case None { 0 } };
    if major < 0 || minor < 0 || patch < 0 {
        if major < 0 {
            return Err(SemverError.Invalid(0));
        }
        if minor < 0 {
            return Err(SemverError.Invalid(first_dot + 1));
        }
        return Err(SemverError.Invalid(second_dot + 1));
    }
    return Ok(Semver {
        major: major,
        minor: minor,
        patch: patch,
        pre: pre.slice(0, pre.len()),
        build: build.slice(0, build.len()),
    });
}

/// One numeric component, parsed without a sign and checked for non-negativity.
fn component([]string parts, int index) -> Result[int, SemverError] {
    const text = switch parts[index] {
        case Some(part) { part }
        case None { "" }
    };
    if text.len() == 0 {
        return Err(SemverError.Invalid(0));
    }
    const parsed = switch text.parse_i64() {
        case Some(value) { value }
        case None { 0 - 1 }
    };
    if parsed < 0 {
        return Err(SemverError.Invalid(0));
    }
    return Ok(parsed);
}

/// The index of `needle` at or after `start`, or `-1`.
fn semver_find_from(string text, string needle, int start) -> int {
    if start >= text.len() || needle.len() == 0 {
        return 0 - 1;
    }
    const string rest = text.slice(start, text.len());
    const at = rest.index_of(needle);
    const int found = switch at {
        case Some(index) { start + index }
        case None { 0 - 1 }
    };
    return found;
}

/// Dot-separated identifiers: letters, digits and hyphens, each non-empty.
/// Numeric pre-release identifiers may not have a leading zero.
fn valid_identifiers(string text, bool no_leading_zero) -> bool {
    if text.len() == 0 {
        return false;
    }
    let start = 0;
    while start < text.len() {
        const dot = semver_find_from(text, ".", start);
        let end = text.len();
    if dot >= 0 { end = dot; }
        const part = text.slice(start, end);
        if part.len() == 0 {
            return false;
        }
        let numeric = true;
        let index = 0;
        while index < part.len() {
            const byte = part.byte_at(index).to_int();
            const digit = byte >= 48 && byte <= 57;
            const letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);
            if !digit && !letter && byte != 45 {
                return false;
            }
            if !digit {
                numeric = false;
            }
            index = index + 1;
        }
        if no_leading_zero && numeric && part.len() > 1 && part.byte_at(0).to_int() == 48 {
            return false;
        }
        if dot < 0 {
            break;
        }
        start = dot + 1;
    }
    return true;
}

/// Compare one dot-separated identifier. Numeric identifiers sort before
/// non-numeric ones, and numbers compare by length then bytes.
fn compare_identifier(string a, string b) -> int {
    const a_numeric = all_digits(a);
    const b_numeric = all_digits(b);
    if a_numeric && !b_numeric {
        return 0 - 1;
    }
    if !a_numeric && b_numeric {
        return 1;
    }
    if a_numeric && b_numeric {
        if a.len() < b.len() {
            return 0 - 1;
        }
        if a.len() > b.len() {
            return 1;
        }
    }
    let index = 0;
    while index < a.len() && index < b.len() {
        const left = a.byte_at(index);
        const right = b.byte_at(index);
        if left != right {
            if left < right { return 0 - 1; }
            return 1;
        }
        index = index + 1;
    }
    if a.len() < b.len() { return 0 - 1; }
    if a.len() > b.len() { return 1; }
    return 0;
}

fn all_digits(string text) -> bool {
    if text.len() == 0 {
        return false;
    }
    let index = 0;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if byte < 48 || byte > 57 {
            return false;
        }
        index = index + 1;
    }
    return true;
}

/// Compare two versions: negative when `a` is older, positive when newer.
pub fn compare(Semver a, Semver b) -> int {
    if a.major < b.major { return 0 - 1; }
    if a.major > b.major { return 1; }
    if a.minor < b.minor { return 0 - 1; }
    if a.minor > b.minor { return 1; }
    if a.patch < b.patch { return 0 - 1; }
    if a.patch > b.patch { return 1; }

    const string a_pre = a.pre;
    const string b_pre = b.pre;
    const a_empty = a_pre.len() == 0;
    const b_empty = b_pre.len() == 0;
    if a_empty && b_empty { return 0; }
    if a_empty { return 1; }
    if b_empty { return 0 - 1; }

    let a_start = 0;
    let b_start = 0;
    while true {
        const a_dot = semver_find_from(a_pre, ".", a_start);
        const b_dot = semver_find_from(b_pre, ".", b_start);
        let a_end = a_pre.len();
        if a_dot >= 0 { a_end = a_dot; }
        let b_end = b_pre.len();
        if b_dot >= 0 { b_end = b_dot; }
        const a_id = a_pre.slice(a_start, a_end);
        const b_id = b_pre.slice(b_start, b_end);
        const order = compare_identifier(a_id, b_id);
        if order != 0 {
            return order;
        }
        if a_dot < 0 && b_dot < 0 {
            return 0;
        }
        if a_dot < 0 {
            return 0 - 1;
        }
        if b_dot < 0 {
            return 1;
        }
        a_start = a_dot + 1;
        b_start = b_dot + 1;
    }
    return 0;
}

/// The full spelling, with build metadata but no normalization.
pub fn to_string(Semver version) -> string {
    let text = str_from_i64(version.major) + "." + str_from_i64(version.minor) + "." + str_from_i64(version.patch);
    const string pre = version.pre;
    if pre.len() > 0 {
        text = text + "-" + pre;
    }
    const string build = version.build;
    if build.len() > 0 {
        text = text + "+" + build;
    }
    return text;
}
