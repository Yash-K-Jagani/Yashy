// Allocator helpers written in Yashy (M6 Task 10).
//
// `alloc(n)` and `p.free()` are builtins over the runtime allocator. The
// helpers cover the two shapes a program reaches for constantly. A pointer is
// linear: the binding that holds it owns it, `move` transfers it, and `.free()`
// is the only release. Both helpers return an owned pointer.
//
/// `alloc(count)` counts `int` slots, not bytes; Yashy has no byte type yet.
/// A pointer to `count` zeroed `int` slots. The caller owns it; release it with
/// `.free()`.
pub fn alloc_zeroed(int count) -> *mut int {
    assert(count >= 0);
    let buffer = alloc(count);
    let index = 0;
    while index < count {
        buffer[index] = 0;
        index = index + 1;
    }
    return buffer;
}

/// A pointer to one `int` slot holding `value`. The caller owns it; release it
/// with `.free()`.
pub fn alloc_one(int value) -> *mut int {
    let buffer = alloc(1);
    buffer[0] = value;
    return buffer;
}
