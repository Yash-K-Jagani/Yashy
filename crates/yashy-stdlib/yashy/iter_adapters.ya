import iter;

// Iteration adapters as plain generic functions (Phase 5 Task 8).
//
// Each adapter walks a sequence and calls a visitor in a defined order. The
// sequence is taken and returned, matching `collections.ya`: a slice is linear,
// so the caller rebinds the answer and stays the sole owner that frees it. An
// adapter is a cursor over the original slice, never a new array of pairs: the
// language cannot pack a tuple into a slice, and a cursor allocates nothing.
// Everything is static dispatch through `fn` parameters, so there is no new
// HIR, no trait object and no hidden allocation on the per-item path.

/// Call `visit(index, value)` for every element of `items`, starting at 0.
/// The index is never negative. Returns `items` so the caller keeps ownership.
pub fn enumerate[T]([]T items, fn(int, T) -> void visit) -> []T {
    let i = 0;
    while i < items.len() {
        const o = items[i];
        const v = switch o { case Some(x) { x } case None { panic("enumerate: index in range") } };
        visit(i, v);
        i = i + 1;
    }
    return items;
}

/// The two sequences a two-input adapter was given, so the caller keeps
/// ownership of both. A struct is used rather than a tuple because a tuple is
/// copied by bytes and cannot own a reference such as a slice.
pub struct PairSeq[A, B] {
    pub left: []A,
    pub right: []B,
}

/// Call `visit(left, right)` for the paired elements of `left` and `right`,
/// stopping at the shorter input and never reading past either. Returns both.
pub fn zip[A, B]([]A left, []B right, fn(A, B) -> void visit) -> PairSeq[A, B] {
    const n = left.len();
    const m = right.len();
    let count = n;
    if m < count { count = m; }
    let i = 0;
    while i < count {
        const oa = left[i];
        const ob = right[i];
        const a = switch oa { case Some(x) { x } case None { panic("zip: index in range") } };
        const b = switch ob { case Some(x) { x } case None { panic("zip: index in range") } };
        visit(a, b);
        i = i + 1;
    }
    return PairSeq { left: left, right: right };
}

/// Call `visit(start, end)` for each non-overlapping window of `size`
/// consecutive elements. `start` is included and `end` excluded; a trailing
/// partial window is still visited, so every element is covered exactly once.
/// A non-positive `size` is an assertion failure rather than an infinite loop.
pub fn chunks[T]([]T items, int size, fn(int, int) -> void visit) -> []T {
    assert(size > 0);
    const n = items.len();
    let start = 0;
    while start < n {
        let end = start + size;
        if end > n { end = n; }
        visit(start, end);
        start = end;
    }
    return items;
}

/// Call `visit(start, end)` for each sliding window of `size` consecutive
/// elements, left to right. `start` is included and `end` excluded. A `size`
/// larger than the sequence visits nothing; a non-positive `size` is an
/// assertion failure.
pub fn windows[T]([]T items, int size, fn(int, int) -> void visit) -> []T {
    assert(size > 0);
    const n = items.len();
    if size > n { return items; }
    let start = 0;
    while start + size <= n {
        visit(start, start + size);
        start = start + 1;
    }
    return items;
}

/// Call `visit(value)` for the first `count` elements, or all of them when
/// `count` is larger. A non-positive `count` visits nothing.
pub fn take[T]([]T items, int count, fn(T) -> void visit) -> []T {
    const n = items.len();
    let limit = count;
    if limit > n { limit = n; }
    if limit < 0 { limit = 0; }
    let i = 0;
    while i < limit {
        const o = items[i];
        const v = switch o { case Some(x) { x } case None { panic("take: index in range") } };
        visit(v);
        i = i + 1;
    }
    return items;
}

/// Call `visit(value)` for every element after the first `count`. A non-positive
/// `count` visits all elements; a `count` past the end visits nothing.
pub fn skip[T]([]T items, int count, fn(T) -> void visit) -> []T {
    const n = items.len();
    let start = count;
    if start < 0 { start = 0; }
    let i = start;
    while i < n {
        const o = items[i];
        const v = switch o { case Some(x) { x } case None { panic("skip: index in range") } };
        visit(v);
        i = i + 1;
    }
    return items;
}

/// Call `visit(value)` for every element from last to first.
pub fn rev[T]([]T items, fn(T) -> void visit) -> []T {
    let i = items.len();
    while i > 0 {
        i = i - 1;
        const o = items[i];
        const v = switch o { case Some(x) { x } case None { panic("rev: index in range") } };
        visit(v);
    }
    return items;
}

/// Call `visit(value)` for every element of `left` then every element of
/// `right`, preserving each sequence's order. Returns both slices.
pub fn chain[A]([]A left, []A right, fn(A) -> void visit) -> PairSeq[A, A] {
    let i = 0;
    while i < left.len() {
        const o = left[i];
        const v = switch o { case Some(x) { x } case None { panic("chain: index in range") } };
        visit(v);
        i = i + 1;
    }
    i = 0;
    while i < right.len() {
        const o = right[i];
        const v = switch o { case Some(x) { x } case None { panic("chain: index in range") } };
        visit(v);
        i = i + 1;
    }
    return PairSeq { left: left, right: right };
}

// --- Adapters as iterator types ---------------------------------------------
//
// The functions above walk a slice and call a visitor. The structs below are
// cursors over the same slices and implement the compiler-known `Iterator`
// protocol, so `for` can drive them without a callback. Each cursor borrows its
// slice; the caller still owns and frees it. A length is stored at construction
// because a method may not call `len` on a field access directly.

/** Pair an indexed element with its index, without inventing a default. */
fn pair_index[T](int index, Option[T] value) -> Option[(int, T)] {
    const Option[(int, T)] missing = None;
    return switch value {
        case Some(element) { Some((index, element)) }
        case None { missing }
    };
}

/** Pair two optional elements, stopping at the shorter sequence. */
fn pair_both[A, B](Option[A] left, Option[B] right) -> Option[(A, B)] {
    const Option[(A, B)] missing = None;
    return switch left {
        case Some(a) {
            switch right {
                case Some(b) { Some((a, b)) }
                case None { missing }
            }
        }
        case None { missing }
    };
}

/** An iterator over a slice that yields `(index, element)` from zero. */
pub struct Enumerate[T] {
    pub values: []T,
    at: int,
    len: int,
}

/** Wrap `values` in an iterator that yields `(index, element)` from zero. */
pub fn enumerate_of[T]([]T values) -> Enumerate[T] {
    return Enumerate { values: values, at: 0, len: values.len() };
}

impl Iterator for Enumerate[T] {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[(int, T)] {
        const at = self[0].at;
        if at >= self[0].len {
            return None;
        }
        self[0].at = at + 1;
        return pair_index(at, self[0].values[at]);
    }
}

/** An iterator over the first `count` elements of a slice. */
pub struct Take[T] {
    pub values: []T,
    at: int,
    len: int,
}

/** Wrap the first `count` elements of `values` in an iterator. */
pub fn take_of[T]([]T values, int count) -> Take[T] {
    let len = count;
    if len > values.len() { len = values.len(); }
    if len < 0 { len = 0; }
    return Take { values: values, at: 0, len: len };
}

impl Iterator for Take[T] {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[T] {
        const at = self[0].at;
        if at >= self[0].len {
            return None;
        }
        self[0].at = at + 1;
        return self[0].values[at];
    }
}

/** An iterator that skips the first `count` elements of a slice. */
pub struct Skip[T] {
    pub values: []T,
    at: int,
    len: int,
}

/** Wrap `values` in an iterator that skips its first `count` elements. */
pub fn skip_of[T]([]T values, int count) -> Skip[T] {
    let at = count;
    if at < 0 { at = 0; }
    return Skip { values: values, at: at, len: values.len() };
}

impl Iterator for Skip[T] {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[T] {
        const len = self[0].len;
        const at = self[0].at;
        if at >= len {
            return None;
        }
        self[0].at = at + 1;
        return self[0].values[at];
    }
}

/** An iterator over a slice from the last element back to the first. */
pub struct Rev[T] {
    pub values: []T,
    at: int,
}

/** Wrap `values` in an iterator that walks it backwards. */
pub fn rev_of[T]([]T values) -> Rev[T] {
    return Rev { values: values, at: values.len() };
}

impl Iterator for Rev[T] {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[T] {
        let at = self[0].at;
        if at <= 0 {
            return None;
        }
        at = at - 1;
        self[0].at = at;
        return self[0].values[at];
    }
}

/** An iterator over pairs from two slices, stopping at the shorter one. */
pub struct Zip[A, B] {
    pub left: []A,
    pub right: []B,
    at: int,
    len: int,
}

/** Wrap two slices in an iterator of pairs, stopping at the shorter one. */
pub fn zip_of[A, B]([]A left, []B right) -> Zip[A, B] {
    let len = left.len();
    if right.len() < len { len = right.len(); }
    return Zip { left: left, right: right, at: 0, len: len };
}

impl Iterator for Zip[A, B] {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[(A, B)] {
        const at = self[0].at;
        if at >= self[0].len {
            return None;
        }
        self[0].at = at + 1;
        return pair_both(self[0].left[at], self[0].right[at]);
    }
}

/** An iterator over two slices, yielding the first and then the second. */
pub struct Chain[T] {
    pub left: []T,
    pub right: []T,
    at: int,
    left_len: int,
    right_len: int,
}

/** Wrap two slices in an iterator that yields `left` then `right`. */
pub fn chain_of[T]([]T left, []T right) -> Chain[T] {
    const left_len = left.len();
    const right_len = right.len();
    return Chain { left: left, right: right, at: 0, left_len: left_len, right_len: right_len };
}

impl Iterator for Chain[T] {
    /// The next element, or `None` after both slices are exhausted.
    pub fn next(self: *mut Self) -> Option[T] {
        const at = self[0].at;
        const left_len = self[0].left_len;
        if at < left_len {
            self[0].at = at + 1;
            return self[0].left[at];
        }
        const right_at = at - left_len;
        if right_at >= self[0].right_len {
            return None;
        }
        self[0].at = at + 1;
        return self[0].right[right_at];
    }
}

/** An iterator over non-overlapping `(start, end)` ranges of a slice. */
pub struct Chunks {
    len: int,
    size: int,
    at: int,
}

/** Describe the chunks of `len` elements in consecutive windows of `size`. */
pub fn chunks_of(int len, int size) -> Chunks {
    assert(size > 0);
    return Chunks { len: len, size: size, at: 0 };
}

impl Iterator for Chunks {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[(int, int)] {
        const at = self[0].at;
        if at >= self[0].len {
            return None;
        }
        let end = at + self[0].size;
        if end > self[0].len { end = self[0].len; }
        self[0].at = end;
        return Some((at, end));
    }
}

/** An iterator over sliding `(start, end)` windows of a slice. */
pub struct Windows {
    len: int,
    size: int,
    at: int,
}

/** Describe the sliding windows of `size` over a slice of `len` elements. */
pub fn windows_of(int len, int size) -> Windows {
    assert(size > 0);
    let at = 0;
    if len < size { at = len + 1; }
    return Windows { len: len, size: size, at: at };
}

impl Iterator for Windows {
    /// The next element, or `None` when the cursor is exhausted.
    pub fn next(self: *mut Self) -> Option[(int, int)] {
        const at = self[0].at;
        if at + self[0].size > self[0].len {
            return None;
        }
        self[0].at = at + 1;
        return Some((at, at + self[0].size));
    }
}
