// Structured events with an injectable writer.
//
// There is no global logger and no hidden sink. A caller passes the function
// that should receive each formatted line, so the same emitter works for a
// terminal, a test buffer or a file. The functions here are pure string work;
// only the writer performs I/O, which keeps the effect at the call site where
// the reader can see it.

import JSON;

/// The default sink: one structured line to stderr.
///
/// It exists so a caller that has no writer can still use the same record
/// shapes. There is no global logger: the function is passed explicitly, and a
/// test can pass its own writer instead.
pub fn stderr_sink(string line) {
    eprint(line + "\n");
}

/// Emit an event to the default stderr sink.
pub fn emit_stderr(string level, string message) {
    emit(stderr_sink, level, message);
}

/// One event as a stable JSON line, with both fields quoted.
pub fn event_json(string level, string message) -> string {
    return "{\"level\":" + JSON.quote(level) + ",\"message\":" + JSON.quote(message) + "}";
}

/// Send an event to the caller-supplied writer.
pub fn emit(fn(string) -> void writer, string level, string message) {
    writer(event_json(level, message));
}

/// The three event levels as stable spellings.
pub enum Level {
    Info,
    Warn,
    Error,
}

/// A trace span as a stable JSON line. `parent_id` is empty for a root span.
/// The duration is microseconds; the shape is fixed so a sink does not have to
/// guess which field is which.
pub fn trace_json(
    string trace_id,
    string span_id,
    string parent_id,
    string operation,
    int duration_us,
) -> string {
    return "{\"kind\":\"trace\",\"trace_id\":" + JSON.quote(trace_id)
        + ",\"span_id\":" + JSON.quote(span_id)
        + ",\"parent_id\":" + JSON.quote(parent_id)
        + ",\"operation\":" + JSON.quote(operation)
        + ",\"duration_us\":" + str_from_i64(duration_us) + "}";
}

/// A metric sample as a stable JSON line. `value` and `labels` are text so the
/// shape works for counters, gauges and histograms without a numeric surprise.
pub fn metric_json(string name, string kind, string value, string labels) -> string {
    return "{\"kind\":\"metric\",\"name\":" + JSON.quote(name)
        + ",\"metric_kind\":" + JSON.quote(kind)
        + ",\"value\":" + JSON.quote(value)
        + ",\"labels\":" + JSON.quote(labels) + "}";
}

/// Send one trace span to the caller-supplied writer.
pub fn trace(
    fn(string) -> void writer,
    string trace_id,
    string span_id,
    string parent_id,
    string operation,
    int duration_us,
) {
    writer(trace_json(trace_id, span_id, parent_id, operation, duration_us));
}

/// Send one metric sample to the caller-supplied writer.
pub fn metric(
    fn(string) -> void writer,
    string name,
    string kind,
    string value,
    string labels,
) {
    writer(metric_json(name, kind, value, labels));
}

/// The spelling a level uses in a JSON event.
pub fn level_text(Level level) -> string {
    return switch level {
        case Info { "info" }
        case Warn { "warn" }
        case Error { "error" }
    };
}
