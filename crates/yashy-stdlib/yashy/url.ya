// The small, total part of RFC 3986: an absolute hierarchical URL.
//
// This parser handles `scheme://authority/path` with an optional port. It does
// not decode percent-escapes, resolve relative references or parse userinfo:
// those belong to a fuller grammar. A malformed spelling is `Err(Invalid)`,
// never a half-filled value with a sentinel host.

/// Why a text is not an absolute hierarchical URL.
pub enum UrlError {
    Invalid,
}

/// A parsed URL: scheme, host, port (0 when absent) and path.
pub struct Url {
    pub scheme: string,
    pub host: string,
    pub port: int,
    pub path: string,
}

/// Parse `scheme://host[:port]/path`.
///
/// A missing scheme separator or an empty scheme or host is `Err(Invalid)`.
/// A port that is not a decimal integer is also refused.
pub fn parse_url(string text) -> Result[Url, UrlError] {
    const at = switch text.index_of("://") {
        case Some(index) { index }
        case None { 0 - 1 }
    };
    if at < 0 {
        return Err(UrlError.Invalid);
    }
    const scheme = text.slice(0, at);
    const after = text.slice(at + 3, text.len());
    const slash = after.index_of("/");
    const authority = switch slash {
        case Some(index) { after.slice(0, index) }
        case None { after }
    };
    const path = switch slash {
        case Some(index) { after.slice(index, after.len()) }
        case None { "" }
    };
    const colon = authority.index_of(":");
    const host = switch colon {
        case Some(index) { authority.slice(0, index) }
        case None { authority }
    };
    const port = switch colon {
        case Some(index) { port_of(authority, index)? }
        case None { 0 }
    };
    if scheme.len() == 0 || host.len() == 0 {
        return Err(UrlError.Invalid);
    }
    return Ok(Url { scheme: scheme, host: host, port: port, path: path });
}

/// The port after a colon, parsed as a positive decimal integer.
fn port_of(string authority, int colon) -> Result[int, UrlError] {
    const text = authority.slice(colon + 1, authority.len());
    const parsed = switch text.parse_i64() {
        case Some(value) { value }
        case None { 0 - 1 }
    };
    if parsed < 0 || parsed > 65535 {
        return Err(UrlError.Invalid);
    }
    return Ok(parsed);
}

/// The `scheme://host` prefix, without port or path.
pub fn origin(Url url) -> string {
    return url.scheme + "://" + url.host;
}

/// Decode `%XX` escapes in a URL component.
///
/// A `%` not followed by two hexadecimal digits is `Err(Invalid)`; a valid
/// escape produces exactly one byte. The `+` spelling is left alone: it is a
/// literal plus in a path and a space only in form bodies, which this module
/// does not parse.
pub fn percent_decode(string text) -> Result[string, UrlError] {
    let out = "";
    let index = 0;
    while index < text.len() {
        if text.byte_at(index).to_int() == 37 {
            if index + 2 >= text.len() {
                return Err(UrlError.Invalid);
            }
            const hi = hex_value(text.byte_at(index + 1));
            const lo = hex_value(text.byte_at(index + 2));
            if hi < 0 || lo < 0 {
                return Err(UrlError.Invalid);
            }
            const char decoded = (hi * 16 + lo).to_char();
            out = out + decoded.to_string();
            index = index + 3;
        } else {
            const char byte = text.byte_at(index);
            out = out + byte.to_string();
            index = index + 1;
        }
    }
    return Ok(out);
}

/// The value of one hexadecimal digit, or `-1`.
fn hex_value(char digit) -> int {
    const value = digit.to_int();
    if value >= 48 && value <= 57 {
        return value - 48;
    }
    if value >= 65 && value <= 70 {
        return value - 55;
    }
    if value >= 97 && value <= 102 {
        return value - 87;
    }
    return 0 - 1;
}
