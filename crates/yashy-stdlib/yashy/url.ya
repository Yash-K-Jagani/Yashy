// The small, total part of RFC 3986: an absolute hierarchical URL.
//
// The parser handles `scheme://[userinfo@]host[:port]/path[?query][#fragment]`.
// A bracketed host is IPv6 and the port follows the closing bracket. It does
// not resolve relative references: those need a base URL and belong to a fuller
// grammar. A malformed spelling is `Err(Invalid)`, never a half-filled value
// with a sentinel host.

/// Why a text is not an absolute hierarchical URL.
pub enum UrlError {
    Invalid,
}

/// A parsed URL: its scheme, authority parts, path, query and fragment.
/// `userinfo`, `query` and `fragment` are empty when absent; `port` is 0 when
/// absent. Bracketed IPv6 hosts keep their brackets in `host`.
pub struct Url {
    pub scheme: string,
    pub userinfo: string,
    pub host: string,
    pub port: int,
    pub path: string,
    pub query: string,
    pub fragment: string,
}

/// The index of `needle` in `text`, or `-1` when absent.
fn index_of_or(string text, string needle) -> int {
    const found = text.index_of(needle);
    return switch found {
        case Some(index) { index }
        case None { 0 - 1 }
    };
}

/// The index of `needle` at or after `start`, or `-1`.
fn find_from(string text, string needle, int start) -> int {
    if start >= text.len() || needle.len() == 0 {
        return 0 - 1;
    }
    const string rest = text.slice(start, text.len());
    return switch rest.index_of(needle) {
        case Some(index) { start + index }
        case None { 0 - 1 }
    };
}

/// The last index of `needle` in `text`, or `-1`.
fn last_index(string text, string needle) -> int {
    let found = 0 - 1;
    let start = 0;
    while start < text.len() {
        const at = find_from(text, needle, start);
        if at < 0 {
            break;
        }
        found = at;
        start = at + needle.len();
    }
    return found;
}

/// Parse `scheme://[userinfo@]host[:port]/path[?query][#fragment]`.
///
/// A missing scheme separator or an empty scheme or host is `Err(Invalid)`.
/// A port that is not a decimal integer in `0..=65535` is also refused. A
/// bracketed host may contain colons (IPv6); the port must follow `]`.
pub fn parse_url(string text) -> Result[Url, UrlError] {
    const at = index_of_or(text, "://");
    if at < 0 {
        return Err(UrlError.Invalid);
    }
    const scheme = text.slice(0, at);
    let rest = text.slice(at + 3, text.len());

    // A fragment runs to the end; a query runs up to the fragment.
    let fragment = "";
    const hash = index_of_or(rest, "#");
    if hash >= 0 {
        fragment = rest.slice(hash + 1, rest.len());
        rest = rest.slice(0, hash);
    }
    let query = "";
    const question = index_of_or(rest, "?");
    if question >= 0 {
        query = rest.slice(question + 1, rest.len());
        rest = rest.slice(0, question);
    }

    // The authority ends at the first slash; the remainder is the path.
    const slash = index_of_or(rest, "/");
    let authority = rest;
    let path = "";
    if slash >= 0 {
        authority = rest.slice(0, slash);
        path = rest.slice(slash, rest.len());
    }

    // Userinfo precedes the last `@`; the host and port follow it.
    let userinfo = "";
    const last_at = last_index(authority, "@");
    if last_at >= 0 {
        userinfo = authority.slice(0, last_at);
        authority = authority.slice(last_at + 1, authority.len());
    }

    // A bracketed host is IPv6: the port, if any, follows the closing bracket.
    let host = "";
    let port = 0;
    if authority.len() > 0 && authority.byte_at(0) == '[' {
        const close = index_of_or(authority, "]");
        if close < 0 {
            return Err(UrlError.Invalid);
        }
        host = authority.slice(0, close + 1);
        const tail = authority.slice(close + 1, authority.len());
        if tail.len() > 0 {
            if tail.byte_at(0) != ':' {
                return Err(UrlError.Invalid);
            }
            port = port_of(tail, 0)?;
        }
    } else {
        const colon = index_of_or(authority, ":");
        if colon >= 0 {
            host = authority.slice(0, colon);
            port = port_of(authority, colon)?;
        } else {
            host = authority;
        }
    }
    if scheme.len() == 0 || host.len() == 0 {
        return Err(UrlError.Invalid);
    }
    return Ok(Url {
        scheme: scheme,
        userinfo: userinfo,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment,
    });
}

/// The port after a colon, parsed as a positive decimal integer.
fn port_of(string authority, int colon) -> Result[int, UrlError] {
    const text = authority.slice(colon + 1, authority.len());
    const parsed = switch text.parse_i64() {
        case Some(value) { value }
        case None { 0 - 1 }
    };
    if parsed < 0 || parsed > 65535 {
        return Err(UrlError.Invalid);
    }
    return Ok(parsed);
}

/// The `scheme://host` prefix, without port or path.
pub fn origin(Url url) -> string {
    return url.scheme + "://" + url.host;
}

/// Decode `%XX` escapes in a URL component.
///
/// A `%` not followed by two hexadecimal digits is `Err(Invalid)`; a valid
/// escape produces exactly one byte. The `+` spelling is left alone: it is a
/// literal plus in a path and a space only in form bodies, which this module
/// does not parse.
pub fn percent_decode(string text) -> Result[string, UrlError] {
    let out = "";
    let index = 0;
    while index < text.len() {
        if text.byte_at(index).to_int() == 37 {
            if index + 2 >= text.len() {
                return Err(UrlError.Invalid);
            }
            const hi = hex_value(text.byte_at(index + 1));
            const lo = hex_value(text.byte_at(index + 2));
            if hi < 0 || lo < 0 {
                return Err(UrlError.Invalid);
            }
            const char decoded = (hi * 16 + lo).to_char();
            out = out + decoded.to_string();
            index = index + 3;
        } else {
            const char byte = text.byte_at(index);
            out = out + byte.to_string();
            index = index + 1;
        }
    }
    return Ok(out);
}

/// The value of one hexadecimal digit, or `-1`.
fn hex_value(char digit) -> int {
    const value = digit.to_int();
    if value >= 48 && value <= 57 {
        return value - 48;
    }
    if value >= 65 && value <= 70 {
        return value - 55;
    }
    if value >= 97 && value <= 102 {
        return value - 87;
    }
    return 0 - 1;
}
