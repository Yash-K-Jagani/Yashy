// The small, total part of RFC 3986: an absolute hierarchical URL.
//
// The parser handles `scheme://[userinfo@]host[:port]/path[?query][#fragment]`.
// A bracketed host is IPv6 and the port follows the closing bracket. It does
// not resolve relative references: those need a base URL and belong to a fuller
// grammar. A malformed spelling is `Err(Invalid)`, never a half-filled value
// with a sentinel host.

/// Why a text is not a well-formed URL. The `int` is the byte offset in the
/// input where the problem begins.
pub enum UrlError {
    Invalid(int),
}

/// A human-readable rendering of a URL error with its byte offset.
pub fn describe_url(UrlError error) -> string {
    return switch error {
        case Invalid(at) { "invalid URL at byte ${at}" }
    };
}

/// A parsed URL: its scheme, authority parts, path, query and fragment.
/// `userinfo`, `query` and `fragment` are empty when absent; `port` is 0 when
/// absent. Bracketed IPv6 hosts keep their brackets in `host`.
pub struct Url {
    pub scheme: string,
    pub userinfo: string,
    pub host: string,
    pub port: int,
    pub path: string,
    pub query: string,
    pub fragment: string,
}

/// The index of `needle` in `text`, or `-1` when absent.
fn index_of_or(string text, string needle) -> int {
    const found = text.index_of(needle);
    return switch found {
        case Some(index) { index }
        case None { 0 - 1 }
    };
}

/// The index of `needle` at or after `start`, or `-1`.
fn url_find_from(string text, string needle, int start) -> int {
    if start >= text.len() || needle.len() == 0 {
        return 0 - 1;
    }
    const string rest = text.slice(start, text.len());
    return switch rest.index_of(needle) {
        case Some(index) { start + index }
        case None { 0 - 1 }
    };
}

/// The last index of `needle` in `text`, or `-1`.
fn last_index(string text, string needle) -> int {
    let found = 0 - 1;
    let start = 0;
    while start < text.len() {
        const at = url_find_from(text, needle, start);
        if at < 0 {
            break;
        }
        found = at;
        start = at + needle.len();
    }
    return found;
}

/// Parse `scheme://[userinfo@]host[:port]/path[?query][#fragment]`.
///
/// A missing scheme separator or an empty scheme or host is `Err(Invalid)`.
/// A port that is not a decimal integer in `0..=65535` is also refused. A
/// bracketed host may contain colons (IPv6); the port must follow `]`.
pub fn parse_url(string text) -> Result[Url, UrlError] {
    const at = index_of_or(text, "://");
    if at < 0 {
        return Err(UrlError.Invalid(0));
    }
    const scheme = text.slice(0, at);
    const rest_start = at + 3;
    let rest = text.slice(rest_start, text.len());

    // A fragment runs to the end; a query runs up to the fragment.
    let fragment = "";
    const hash = index_of_or(rest, "#");
    if hash >= 0 {
        fragment = rest.slice(hash + 1, rest.len());
        rest = rest.slice(0, hash);
    }
    let query = "";
    const question = index_of_or(rest, "?");
    if question >= 0 {
        query = rest.slice(question + 1, rest.len());
        rest = rest.slice(0, question);
    }

    // The authority ends at the first slash; the remainder is the path.
    const slash = index_of_or(rest, "/");
    let authority = rest;
    let path = "";
    if slash >= 0 {
        authority = rest.slice(0, slash);
        path = rest.slice(slash, rest.len());
    }

    // Userinfo precedes the last `@`; the host and port follow it.
    let userinfo = "";
    let authority_start = rest_start;
    const last_at = last_index(authority, "@");
    if last_at >= 0 {
        userinfo = authority.slice(0, last_at);
        authority = authority.slice(last_at + 1, authority.len());
        authority_start = authority_start + last_at + 1;
    }

    // A bracketed host is IPv6: the port, if any, follows the closing bracket.
    let host = "";
    let port = 0;
    if authority.len() > 0 && authority.byte_at(0) == '[' {
        const close = index_of_or(authority, "]");
        if close < 0 {
            return Err(UrlError.Invalid(authority_start));
        }
        host = authority.slice(0, close + 1);
        const tail = authority.slice(close + 1, authority.len());
        if tail.len() > 0 {
            if tail.byte_at(0) != ':' {
                return Err(UrlError.Invalid(authority_start + close + 1));
            }
            port = port_of(tail, 0);
            if port < 0 {
                return Err(UrlError.Invalid(authority_start + close + 2));
            }
        }
    } else {
        const colon = index_of_or(authority, ":");
        if colon >= 0 {
            host = authority.slice(0, colon);
            port = port_of(authority, colon);
            if port < 0 {
                return Err(UrlError.Invalid(authority_start + colon + 1));
            }
        } else {
            host = authority;
        }
    }
    if scheme.len() == 0 {
        return Err(UrlError.Invalid(0));
    }
    if host.len() == 0 {
        return Err(UrlError.Invalid(authority_start));
    }
    return Ok(Url {
        scheme: scheme,
        userinfo: userinfo,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment,
    });
}

/// The port after a colon, parsed as a decimal integer, or `-1` when it is
/// not a port in `0..=65535`. The caller builds the byte-offset error.
fn port_of(string authority, int colon) -> int {
    const text = authority.slice(colon + 1, authority.len());
    const parsed = switch text.parse_i64() {
        case Some(value) { value }
        case None { 0 - 1 }
    };
    if parsed < 0 || parsed > 65535 {
        return 0 - 1;
    }
    return parsed;
}

/// The `scheme://host` prefix, without port or path.
pub fn origin(Url url) -> string {
    return url.scheme + "://" + url.host;
}

/// Resolve a URI reference against a base URL (RFC 3986 §5.2).
///
/// Handles all five reference forms: an absolute URI, a network-path
/// reference (`//host/path`), an absolute-path reference (`/path`), a
/// relative-path reference (`a/b`), and a query- or fragment-only reference.
/// Dot segments (`.` and `..`) in the merged path are removed. The answer is a
/// URL string, always absolute; a malformed base is `Err(Invalid)`.
pub fn resolve(string base, string reference) -> Result[string, UrlError] {
    const parsed_base = parse_url(base)?;

    // An absolute reference has its own scheme: return it unchanged.
    const scheme_end = index_of_or(reference, ":");
    if scheme_end > 0 && is_scheme(reference.slice(0, scheme_end)) {
        return Ok(reference);
    }

    // Strip a fragment from the reference; it is re-appended at the end.
    let ref_frag = "";
    let target = reference;
    const hash = index_of_or(target, "#");
    if hash >= 0 {
        ref_frag = target.slice(hash, target.len());
        target = target.slice(0, hash);
    }

    // A network-path reference borrows the base scheme.
    if target.starts_with("//") {
        return Ok(parsed_base.scheme + ":" + target + ref_frag);
    }

    // Split the reference's query from its path.
    let ref_query = "";
    let ref_path = target;
    const question = index_of_or(target, "?");
    if question >= 0 {
        ref_query = target.slice(question, target.len());
        ref_path = target.slice(0, question);
    }

    if ref_path.len() == 0 {
        // Empty path: keep the base path and query, replace only the fragment.
        const base_query = parsed_base.query;
        const query_part = query_suffix(base_query);
        return Ok(parsed_base.scheme + "://" + authority_of(parsed_base) + parsed_base.path + query_part + ref_frag);
    }

    let merged = "";
    if ref_path.starts_with("/") {
        merged = ref_path;
    } else {
        // Relative path: merge with the base's directory (up to the last `/`).
        const bp = parsed_base.path;
        const last_slash = last_index(bp, "/");
        const dir = directory_of(bp, last_slash);
        merged = dir + ref_path;
    }
    const clean = remove_dot_segments(merged);
    return Ok(parsed_base.scheme + "://" + authority_of(parsed_base) + clean + ref_query + ref_frag);
}

/// The directory of a path (through its last slash), or `/` when none.
fn directory_of(string path, int last_slash) -> string {
    if last_slash >= 0 {
        return path.slice(0, last_slash + 1);
    }
    return "/";
}

/// A query string prefixed with `?`, or empty when there is no query.
fn query_suffix(string query) -> string {
    if query.len() > 0 {
        return "?" + query;
    }
    return "";
}

/// The authority of a parsed URL: userinfo@host[:port].
fn authority_of(Url url) -> string {
    const string info = url.userinfo;
    const string host = url.host;
    const int port = url.port;
    let auth = host;
    if info.len() > 0 {
        auth = info + "@" + auth;
    }
    if port > 0 {
        auth = auth + ":" + str_from_i64(port);
    }
    return auth;
}

/// Whether `text` is a URI scheme: a letter followed by letters, digits, `+`,
/// `-` or `.`.
fn is_scheme(string text) -> bool {
    if text.len() == 0 {
        return false;
    }
    const first = text.byte_at(0).to_int();
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) {
        return false;
    }
    let i = 1;
    while i < text.len() {
        const b = text.byte_at(i).to_int();
        const ok = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
            || (b >= 48 && b <= 57) || b == 43 || b == 45 || b == 46;
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Remove `.` and `..` path segments from an absolute path (RFC 3986 §5.2.4).
///
/// The output is built as a string of `/segment` pieces. A `..` drops the last
/// piece by truncating at its slash, so no array of owned strings is needed.
fn remove_dot_segments(string path) -> string {
    const segments = path.split("/");
    let out = "";
    for i in 0..segments.len() {
        const part = switch segments[i] {
            case Some(p) { p }
            case None { "" }
        };
        if part == "." || part.len() == 0 {
            continue;
        }
        if part == ".." {
            const slash = last_index(out, "/");
            if slash >= 0 {
                out = out.slice(0, slash);
            }
            continue;
        }
        out = out + "/" + part;
    }
    segments.free();
    if out.len() == 0 {
        return "/";
    }
    return out;
}

/// Decode `%XX` escapes in a URL component.
///
/// A `%` not followed by two hexadecimal digits is `Err(Invalid)`; a valid
/// escape produces exactly one byte. The `+` spelling is left alone: it is a
/// literal plus in a path and a space only in form bodies, which this module
/// does not parse.
pub fn percent_decode(string text) -> Result[string, UrlError] {
    let out = "";
    let index = 0;
    while index < text.len() {
        if text.byte_at(index).to_int() == 37 {
            if index + 2 >= text.len() {
                return Err(UrlError.Invalid(index));
            }
            const hi = url_hex_value(text.byte_at(index + 1));
            const lo = url_hex_value(text.byte_at(index + 2));
            if hi < 0 || lo < 0 {
                return Err(UrlError.Invalid(index));
            }
            const char decoded = (hi * 16 + lo).to_char();
            out = out + decoded.to_string();
            index = index + 3;
        } else {
            const char byte = text.byte_at(index);
            out = out + byte.to_string();
            index = index + 1;
        }
    }
    return Ok(out);
}

/// The value of one hexadecimal digit, or `-1`.
fn url_hex_value(char digit) -> int {
    const value = digit.to_int();
    if value >= 48 && value <= 57 {
        return value - 48;
    }
    if value >= 65 && value <= 70 {
        return value - 55;
    }
    if value >= 97 && value <= 102 {
        return value - 87;
    }
    return 0 - 1;
}
