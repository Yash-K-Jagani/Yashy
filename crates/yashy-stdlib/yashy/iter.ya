// The iterator protocol: the one generic trait the language has.
//
// `Iterator[T]` is compiler-known: user traits may not carry type
// parameters (`E1511`), but this one is the exception because the `for`
// loop over a user type lowers through it. A type implements it by
// providing `next(self: *mut Self) -> Option[T]`, where `T` is the element
// type. There is no `iter()` method in v1: the iterable is the iterator.

/// An iterator over elements of type `T`: the one generic trait the
/// language has. A type implements it by providing `next`, which answers
/// the next element or `None` at the end; a `for` loop over a user type
/// lowers through it.
pub trait Iterator[T] {
    fn next(self: *mut Self) -> Option[T];
}

/// Whether `next`'s answer is the end of the sequence. An implementation reads
/// the protocol as "yield until `is_done`", so the test lives here rather than
/// being spelled out in every implementor.
pub fn is_done[T](Option[T] next) -> bool {
    return switch next {
        case Some(_) {
            false
        }
        case None {
            true
        }
    };
}
