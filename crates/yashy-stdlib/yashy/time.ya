// Time (phase 12, Task 10).
//
// Two clocks, named so a reader does not have to guess:
//
// - `now()` and `sleep(ms)` are builtins in the shared scope. `now()` is
//   milliseconds since the Unix epoch from the wall clock; an adjustment can
//   make a later call smaller. `sleep(ms)` blocks for at least `ms`
//   milliseconds and treats a non-positive value as a no-op.
// - `monotonic_ns()` only moves forward. It is for elapsed time and ordering,
//   not for a timestamp: its zero point is unspecified.
// - `now_unix_ns()` is the wall clock at nanosecond resolution; the platform
//   may return it at a coarser granularity (Windows' clock ticks are 100 ns).
//
// Ownership: none; every function answers a number.

extern "C" {
    unsafe fn yashy_monotonic_ns() -> int;
    unsafe fn yashy_now_unix_ns() -> int;
}

/// Nanoseconds from an unspecified origin, never decreasing.
pub fn monotonic_ns() -> int {
    return yashy_monotonic_ns();
}

/// Nanoseconds since the Unix epoch, from the wall clock.
pub fn now_unix_ns() -> int {
    return yashy_now_unix_ns();
}
