// Collections (phase 12, Task 10).
//
// Sets, deques, and a priority queue as generic free functions over slices.
//
// Why functions and not structs: `impl Set[T]` cannot be written (an
// `impl` block names one concrete type), and a struct field cannot hold a
// `fn` value, so the priority queue's comparator is a per-call argument.
//
// A slice is linear: passing one to a function moves it, so every operation
// takes the collection and answers it back. The caller binds the answer:
// `items = set_insert(items, 3);`. A question that only reads -- does the set
// hold this value, what is on top of the queue -- answers the collection
// together with the answer, in `QHas` or `QPop`, so the caller keeps using the
// collection instead of giving it up to ask. Reading one element is an index
// (`switch items[index]`), which borrows; a helper that took the slice would
// move it.
//
// An array held in a struct field is a header that points at storage the
// struct does not own (tutorial 04). So `step.items` names the same array the
// binding names, and the binding is what frees it.

import iter_adapters;

/** The collection and the element a pop or a peek found, if any. */
pub struct QPop[T] {
    pub items: []T,
    pub value: Option[T],
}

/** The collection and whether it holds the value that was asked about. */
pub struct QHas[T] {
    pub items: []T,
    pub found: bool,
}

/** Insert `value` if it is not already present; otherwise unchanged. */
pub fn set_insert[T]([]T items, T value) -> []T {
    let index = 0;
    while index < items.len() {
        const item = switch items[index] {
            case Some(element) {
                element
            }
            case None {
                panic("a set index is always in range")
            }
        };
        if item == value {
            return items;
        }
        index = index + 1;
    }
    items.push(value);
    return items;
}

/** Whether `value` is already in the collection, with the collection back. */
pub fn set_contains[T]([]T items, T value) -> QHas[T] {
    let index = 0;
    while index < items.len() {
        const item = switch items[index] {
            case Some(element) {
                element
            }
            case None {
                panic("a set index is always in range")
            }
        };
        if item == value {
            return QHas {
                items: items, found: true
            };
        }
        index = index + 1;
    }
    return QHas {
        items: items, found: false
    };
}

/** Remove `value` if present; otherwise unchanged. */
pub fn set_remove[T]([]T items, T value) -> []T {
    let index = 0;
    while index < items.len() {
        const item = switch items[index] {
            case Some(element) {
                element
            }
            case None {
                panic("a set index is always in range")
            }
        };
        if item == value {
            items.remove(index);
            return items;
        }
        index = index + 1;
    }
    return items;
}

/** Push `value` at the back. */
pub fn deque_push_back[T]([]T items, T value) -> []T {
    items.push(value);
    return items;
}

/** Push `value` at the front. */
pub fn deque_push_front[T]([]T items, T value) -> []T {
    items.insert(0, value);
    return items;
}

/** The back element without removing it, with the collection back. */
pub fn deque_back[T]([]T items) -> QPop[T] {
    const value = items.last();
    return QPop {
        items: items, value: value
    };
}

/** The front element without removing it, with the collection back. */
pub fn deque_front[T]([]T items) -> QPop[T] {
    const value = items.first();
    return QPop {
        items: items, value: value
    };
}

/** Remove and return the back, or `None` when empty. */
pub fn deque_pop_back[T]([]T items) -> QPop[T] {
    const value = items.pop();
    return QPop {
        items: items, value: value
    };
}

/** Remove and return the front, or `None` when empty. */
pub fn deque_pop_front[T]([]T items) -> QPop[T] {
    const value = items.remove(0);
    return QPop {
        items: items, value: value
    };
}

/** Push `value`, re-heapifying upward under `cmp`. */
pub fn queue_push[T]([]T items, T value, fn (T, T) -> int cmp) -> []T {
    items.push(value);
    let index = items.len() - 1;
    while index > 0 {
        const parent = (index - 1) / 2;
        const parent_value = switch items[parent] {
            case Some(element) {
                element
            }
            case None {
                panic("a heap index is always in range")
            }
        };
        const index_value = switch items[index] {
            case Some(element) {
                element
            }
            case None {
                panic("a heap index is always in range")
            }
        };
        if cmp(parent_value, index_value) > 0 {
            items.set(index, parent_value);
            items.set(parent, index_value);
            index = parent;
        } else {
            break;
        }
    }
    return items;
}

/** Remove and return the smallest element under `cmp`, or `None` when empty. */
pub fn queue_pop[T]([]T items, fn (T, T) -> int cmp) -> QPop[T] {
    if items.len() == 0 {
        const Option[T] missing = None;
        return QPop {
            items: items, value: missing
        };
    }
    const value = items.remove(0);
    if items.len() > 0 {
        // The last element takes the root's place, then sifts down.
        const last = items.pop();
        const last_value = switch last {
            case Some(element) {
                element
            }
            case None {
                panic("a non-empty queue has a last element")
            }
        };
        items.insert(0, last_value);
        let index = 0;
        while true {
            let smallest = index;
            const left = 2 * index + 1;
            if left >= items.len() {
                break;
            }
            const left_value = switch items[left] {
                case Some(element) {
                    element
                }
                case None {
                    panic("a heap index is always in range")
                }
            };
            const best_value = switch items[smallest] {
                case Some(element) {
                    element
                }
                case None {
                    panic("a heap index is always in range")
                }
            };
            if cmp(left_value, best_value) < 0 {
                smallest = left;
            }
            const right = left + 1;
            if right < items.len() {
                const right_value = switch items[right] {
                    case Some(element) {
                        element
                    }
                    case None {
                        panic("a heap index is always in range")
                    }
                };
                const current_best = switch items[smallest] {
                    case Some(element) {
                        element
                    }
                    case None {
                        panic("a heap index is always in range")
                    }
                };
                if cmp(right_value, current_best) < 0 {
                    smallest = right;
                }
            }
            if smallest == index {
                break;
            }
            const index_value = switch items[index] {
                case Some(element) {
                    element
                }
                case None {
                    panic("a heap index is always in range")
                }
            };
            const smallest_value = switch items[smallest] {
                case Some(element) {
                    element
                }
                case None {
                    panic("a heap index is always in range")
                }
            };
            items.set(index, smallest_value);
            items.set(smallest, index_value);
            index = smallest;
        }
    }
    return QPop {
        items: items, value: value
    };
}

/** The smallest element without removing it, with the collection back. */
pub fn queue_peek[T]([]T items) -> QPop[T] {
    const value = items.first();
    return QPop {
        items: items, value: value
    };
}

/** Push `value`, and keep the slice sorted ascending. (`[]int` only.) */
pub fn int_sort_insert([]int items, int value) -> []int {
    let index = 0;
    while index < items.len() {
        const current = switch items[index] {
            case Some(element) {
                element
            }
            case None {
                0
            }
        };
        if current > value {
            break;
        }
        index = index + 1;
    }
    items.insert(index, value);
    return items;
}

// --- Collections as types ---------------------------------------------------
//
// The functions above stay: they are the original value-oriented interface.
// The types below wrap the same arrays in a receiver, so a program can write
// `items.push(value)` instead of `items = array_push(items, value)`. A struct
// holds the array header; the binding that owns the struct releases it with
// `free`. Nothing is copied on a method call.
//
// A `string` column cannot be overwritten or removed in place (the array owns
// the old reference), so the map keeps append-only columns plus an `int` slot
// per key row, the same shape `ordered_map.ya` uses. A `set` of the key row
// redirects an overwrite; a `set` of a live flag records a removal.

/** An optional element equals a value, without inventing a default element. */
fn same_element[T](Option[T] found, T value) -> bool {
    return switch found {
        case Some(element) { element == value }
        case None { false }
    };
}

/** A growable sequence that keeps insertion order. Release it with `free`. */
pub struct Vec[T] {
    pub items: []T,
}

/** A fresh empty vector. The caller owns the array and frees it with `free`. */
pub fn vec_new[T]() -> Vec[T] {
    return Vec { items: []T {} };
}

impl Vec[T] {
    /// The number of elements.
    pub fn len(self) -> int {
        const items = self.items;
        return items.len();
    }

    /// The element at `index`, or `None` when it is out of range.
    pub fn get(self, int index) -> Option[T] {
        return self.items[index];
    }

    /// Append `value` at the end.
    pub fn push(self: *mut Vec[T], T value) {
        let items = self[0].items;
        items.push(value);
        self[0].items = items;
    }

    /// Remove and answer the last element, or `None` when empty.
    pub fn pop(self: *mut Vec[T]) -> Option[T] {
        let items = self[0].items;
        const value = items.pop();
        self[0].items = items;
        return value;
    }

    /// Wrap the elements in an iterator that yields `(index, element)`.
    pub fn enumerate(self) -> Enumerate[T] {
        return enumerate_of(self.items);
    }

    /// Release the backing array. The vector must not be used afterwards.
    pub fn free(self) {
        const items = self.items;
        items.free();
    }
}

/** A set with insertion order. Release it with `free`. */
pub struct Set[T] {
    pub items: []T,
}

/** A fresh empty set. The caller owns the array and frees it with `free`. */
pub fn set_new[T]() -> Set[T] {
    return Set { items: []T {} };
}

impl Set[T] {
    /// The number of members.
    pub fn len(self) -> int {
        const items = self.items;
        return items.len();
    }

    /// Whether the set holds `value`.
    pub fn contains(self, T value) -> bool {
        const []T items = self.items;
        let index = 0;
        while index < items.len() {
            if same_element(items[index], value) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /// Add `value` when it is absent. The order of existing members is kept.
    pub fn insert(self: *mut Set[T], T value) {
        const set = self[0];
        if set.contains(value) {
            return;
        }
        let items = self[0].items;
        items.push(value);
        self[0].items = items;
    }

    /// The member at row `index` in insertion order, or `None` past the end.
    pub fn at(self, int index) -> Option[T] {
        return self.items[index];
    }

    /// Release the backing array. The set must not be used afterwards.
    pub fn free(self) {
        const items = self.items;
        items.free();
    }
}

/** A double-ended sequence. Release it with `free`. */
pub struct Deque[T] {
    pub items: []T,
}

/** A fresh empty deque. The caller owns the array and frees it with `free`. */
pub fn deque_new[T]() -> Deque[T] {
    return Deque { items: []T {} };
}

impl Deque[T] {
    /// The number of elements.
    pub fn len(self) -> int {
        const items = self.items;
        return items.len();
    }

    /// Append `value` at the back.
    pub fn push_back(self: *mut Deque[T], T value) {
        let items = self[0].items;
        items.push(value);
        self[0].items = items;
    }

    /// Prepend `value` at the front.
    pub fn push_front(self: *mut Deque[T], T value) {
        let items = self[0].items;
        items.insert(0, value);
        self[0].items = items;
    }

    /// The front element without removing it, or `None` when empty.
    pub fn front(self: *mut Deque[T]) -> Option[T] {
        let items = self[0].items;
        const value = items.first();
        self[0].items = items;
        return value;
    }

    /// The back element without removing it, or `None` when empty.
    pub fn back(self: *mut Deque[T]) -> Option[T] {
        let items = self[0].items;
        const value = items.last();
        self[0].items = items;
        return value;
    }

    /// Remove and answer the front element, or `None` when empty.
    pub fn pop_front(self: *mut Deque[T]) -> Option[T] {
        let items = self[0].items;
        const value = items.remove(0);
        self[0].items = items;
        return value;
    }

    /// Remove and answer the back element, or `None` when empty.
    pub fn pop_back(self: *mut Deque[T]) -> Option[T] {
        let items = self[0].items;
        const value = items.pop();
        self[0].items = items;
        return value;
    }

    /// Release the backing array. The deque must not be used afterwards.
    pub fn free(self) {
        const items = self.items;
        items.free();
    }
}

/** A map with insertion-ordered iteration. Release it with `free`. */
pub struct Map[K, V] {
    pub keys: []K,
    pub values: []V,
    pub slots: []int,
    pub live: []int,
}

/** A fresh empty map. The caller owns the columns and frees them with `free`. */
pub fn map_new[K, V]() -> Map[K, V] {
    return Map {
        keys: []K {},
        values: []V {},
        slots: []int {},
        live: []int {},
    };
}

impl Map[K, V] {
    /// The number of live entries.
    pub fn len(self) -> int {
        const []int live = self.live;
        let count = 0;
        let index = 0;
        while index < live.len() {
            const int flag = switch live[index] { case Some(value) { value } case None { 0 } };
            count = count + flag;
            index = index + 1;
        }
        return count;
    }

    /// The row holding `key`, or `-1` when it is absent.
    fn row(self, K key) -> int {
        const []int live = self.live;
        let index = 0;
        while index < live.len() {
            const int flag = switch live[index] { case Some(value) { value } case None { 0 } };
            if flag == 1 && same_element(self.keys[index], key) {
                return index;
            }
            index = index + 1;
        }
        return 0 - 1;
    }

    /// The value under `key`, or `None` when it is absent.
    pub fn get(self, K key) -> Option[V] {
        const int at = self.row(key);
        if at < 0 {
            const Option[V] missing = None;
            return missing;
        }
        const Option[int] slot = self.slots[at];
        const int index = switch slot { case Some(value) { value } case None { 0 } };
        return self.values[index];
    }

    /// Insert or overwrite `key`. An overwrite keeps the key's position.
    pub fn put(self: *mut Map[K, V], K key, V value) {
        const map = self[0];
        const int at = map.row(key);
        let values = self[0].values;
        values.push(value);
        const int slot = values.len() - 1;
        self[0].values = values;
        if at >= 0 {
            let slots = self[0].slots;
            slots.set(at, slot);
            self[0].slots = slots;
            return;
        }
        let keys = self[0].keys;
        keys.push(key);
        self[0].keys = keys;
        let slots = self[0].slots;
        slots.push(slot);
        self[0].slots = slots;
        let live = self[0].live;
        live.push(1);
        self[0].live = live;
    }

    /// Remove `key`. The remaining keys keep their positions.
    pub fn remove(self: *mut Map[K, V], K key) -> Option[V] {
        const map = self[0];
        const int at = map.row(key);
        if at < 0 {
            const Option[V] missing = None;
            return missing;
        }
        const Option[int] slot = self[0].slots[at];
        const int index = switch slot { case Some(value) { value } case None { 0 } };
        let live = self[0].live;
        live.set(at, 0);
        self[0].live = live;
        return self[0].values[index];
    }

    /// The live key at position `index`, or `None` past the end.
    pub fn key(self, int index) -> Option[K] {
        const []int live = self.live;
        let seen = 0;
        let row = 0;
        while row < live.len() {
            const int flag = switch live[row] { case Some(value) { value } case None { 0 } };
            if flag == 1 {
                if seen == index {
                    return self.keys[row];
                }
                seen = seen + 1;
            }
            row = row + 1;
        }
        const Option[K] missing = None;
        return missing;
    }

    /// The value at position `index`, or `None` past the end.
    pub fn value(self, int index) -> Option[V] {
        const []int live = self.live;
        let seen = 0;
        let row = 0;
        while row < live.len() {
            const int flag = switch live[row] { case Some(value) { value } case None { 0 } };
            if flag == 1 {
                if seen == index {
                    const Option[int] slot = self.slots[row];
                    const int at = switch slot { case Some(value) { value } case None { 0 } };
                    return self.values[at];
                }
                seen = seen + 1;
            }
            row = row + 1;
        }
        const Option[V] missing = None;
        return missing;
    }

    /// Release every column. The map must not be used afterwards.
    pub fn free(self) {
        const keys = self.keys;
        const values = self.values;
        const slots = self.slots;
        const live = self.live;
        keys.free();
        values.free();
        slots.free();
        live.free();
    }

    /// Whether the map holds `key`.
    pub fn contains_key(self, K key) -> bool {
        return self.row(key) >= 0;
    }

    /// Answer the value under `key`, inserting `fallback` when it is absent.
    pub fn get_or(self: *mut Map[K, V], K key, V fallback) -> V {
        const map = self[0];
        if map.contains_key(key) {
            return switch map.get(key) {
                case Some(value) { value }
                case None { fallback }
            };
        }
        let values = self[0].values;
        values.push(fallback);
        const int slot = values.len() - 1;
        self[0].values = values;
        let keys = self[0].keys;
        keys.push(key);
        self[0].keys = keys;
        let slots = self[0].slots;
        slots.push(slot);
        self[0].slots = slots;
        let live = self[0].live;
        live.push(1);
        self[0].live = live;
        return fallback;
    }

    /// Apply `change` to the value under `key`; an absent key is untouched.
    pub fn update(self: *mut Map[K, V], K key, fn (V) -> V change) {
        const map = self[0];
        if !map.contains_key(key) {
            return;
        }
        const Option[V] missing = None;
        const updated = switch map.get(key) {
            case Some(value) { Some(change(value)) }
            case None { missing }
        };
        if !(updated matches Some(_)) {
            return;
        }
        const current = switch updated {
            case Some(value) { value }
            case None { panic("update: the key was checked to be present") }
        };
        let values = self[0].values;
        values.push(current);
        const int slot = values.len() - 1;
        self[0].values = values;
        let slots = self[0].slots;
        const int at = map.row(key);
        slots.set(at, slot);
        self[0].slots = slots;
    }

    /// A cursor over the live entries in insertion order.
    pub fn iter(self) -> MapIter[K, V] {
        const keys = self.keys;
        return MapIter {
            keys: keys,
            values: self.values,
            slots: self.slots,
            live: self.live,
            at: 0,
            len: keys.len(),
        };
    }
}

/** Compare a comparator's answer, breaking a tie by insertion sequence. */
fn pq_order(int order, int left_seq, int right_seq) -> bool {
    if order < 0 { return true; }
    if order > 0 { return false; }
    return left_seq < right_seq;
}

/** The smaller of two optional values, breaking equal keys by insertion
 * sequence. A missing value never wins, so the helper needs no default `T`. */
fn pq_before[T](Option[T] left, int left_seq, Option[T] right, int right_seq, fn (T, T) -> int cmp) -> bool {
    return switch left {
        case Some(a) {
            switch right {
                case Some(b) { pq_order(cmp(a, b), left_seq, right_seq) }
                case None { false }
            }
        }
        case None { false }
    };
}

/** A min-queue that breaks equal keys by insertion sequence. The value column
 * is append-only, and the heap holds `int` indices into it, so a swap never
 * has to set a `string` element. */
pub struct PriorityQueue[T] {
    pub values: []T,
    pub heap: []int,
    pub count: int,
}

/** A fresh empty priority queue. Release it with `free`. */
pub fn pq_new[T]() -> PriorityQueue[T] {
    return PriorityQueue { values: []T {}, heap: []int {}, count: 0 };
}

impl PriorityQueue[T] {
    /// The number of queued elements.
    pub fn len(self) -> int {
        return self.count;
    }

    /// The smallest element under `cmp`, without removing it.
    pub fn peek(self, fn (T, T) -> int cmp) -> Option[T] {
        if self.count == 0 {
            const Option[T] missing = None;
            return missing;
        }
        const Option[int] first = self.heap[0];
        const int index = switch first { case Some(value) { value } case None { 0 } };
        return self.values[index];
    }

    /// Insert `value`, re-heapifying with `cmp` and insertion order as the key.
    pub fn push(self: *mut PriorityQueue[T], T value, fn (T, T) -> int cmp) {
        let values = self[0].values;
        values.push(value);
        const int index = values.len() - 1;
        self[0].values = values;
        let heap = self[0].heap;
        heap.push(index);
        let at = heap.len() - 1;
        self[0].count = self[0].count + 1;
        while at > 0 {
            const parent = (at - 1) / 2;
            const int child_slot = switch heap[at] { case Some(v) { v } case None { 0 } };
            const int parent_slot = switch heap[parent] { case Some(v) { v } case None { 0 } };
            if pq_before(self[0].values[child_slot], child_slot, self[0].values[parent_slot], parent_slot, cmp) {
                heap.set(at, parent_slot);
                heap.set(parent, child_slot);
                at = parent;
            } else {
                break;
            }
        }
        self[0].heap = heap;
    }

    /// Remove and answer the smallest element, or `None` when empty.
    pub fn pop(self: *mut PriorityQueue[T], fn (T, T) -> int cmp) -> Option[T] {
        if self[0].count == 0 {
            const Option[T] missing = None;
            return missing;
        }
        let heap = self[0].heap;
        const Option[int] root = heap[0];
        const int index = switch root { case Some(value) { value } case None { 0 } };
        const last = heap.len() - 1;
        const Option[int] tail = heap[last];
        const int tail_slot = switch tail { case Some(value) { value } case None { 0 } };
        heap.set(0, tail_slot);
        let at = 0;
        while true {
            const left = 2 * at + 1;
            if left >= last {
                break;
            }
            let best = at;
            const int at_slot = switch heap[at] { case Some(v) { v } case None { 0 } };
            const int left_slot = switch heap[left] { case Some(v) { v } case None { 0 } };
            if pq_before(self[0].values[left_slot], left_slot, self[0].values[at_slot], at_slot, cmp) {
                best = left;
            }
            const right = left + 1;
            if right < last {
                const int best_slot = switch heap[best] { case Some(v) { v } case None { 0 } };
                const int right_slot = switch heap[right] { case Some(v) { v } case None { 0 } };
                if pq_before(self[0].values[right_slot], right_slot, self[0].values[best_slot], best_slot, cmp) {
                    best = right;
                }
            }
            if best == at {
                break;
            }
            const int best_slot = switch heap[best] { case Some(v) { v } case None { 0 } };
            const int here_slot = switch heap[at] { case Some(v) { v } case None { 0 } };
            heap.set(at, best_slot);
            heap.set(best, here_slot);
            at = best;
        }
        heap.remove(last);
        self[0].heap = heap;
        self[0].count = self[0].count - 1;
        return self[0].values[index];
    }

    /// Release the value and heap arrays. The queue must not be used afterwards.
    pub fn free(self) {
        const values = self.values;
        const heap = self.heap;
        values.free();
        heap.free();
    }
}

/** One live map row. A struct, not a tuple: a tuple cannot own a string. */
pub struct MapEntry[K, V] {
    pub key: K,
    pub value: V,
}

/** Pair a live map row with the value its slot points at. */
fn map_entry[K, V](Option[K] key, Option[int] slot, []V values) -> Option[MapEntry[K, V]] {
    const Option[MapEntry[K, V]] missing = None;
    return switch key {
        case Some(name) {
            switch slot {
                case Some(at) {
                    switch values[at] {
                        case Some(value) { Some(MapEntry { key: name, value: value }) }
                        case None { missing }
                    }
                }
                case None { missing }
            }
        }
        case None { missing }
    };
}

/** A cursor over the live entries of a map, in insertion order. */
pub struct MapIter[K, V] {
    keys: []K,
    values: []V,
    slots: []int,
    live: []int,
    at: int,
    len: int,
}

impl Iterator for MapIter[K, V] {
    /// The next live entry, or `None` at the end.
    pub fn next(self: *mut Self) -> Option[MapEntry[K, V]] {
        let at = self[0].at;
        while at < self[0].len {
            const int flag = switch self[0].live[at] { case Some(value) { value } case None { 0 } };
            at = at + 1;
            if flag == 1 {
                self[0].at = at;
                return map_entry(self[0].keys[at - 1], self[0].slots[at - 1], self[0].values);
            }
        }
        self[0].at = at;
        const Option[MapEntry[K, V]] missing = None;
        return missing;
    }
}
