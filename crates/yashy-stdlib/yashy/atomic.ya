// Atomic operations with explicit memory orderings.
//
// An atomic is a slot handle into a fixed C11 atomic table. Every operation
// names its ordering: there is no default and no implicit SeqCst. AcqRel is
// only valid for a read-modify-write; the wrapper rejects it for load and
// store so an invalid ordering is a diagnostic rather than a silent
// strengthening.

extern "C" link "../native/atomic_shim.c" {
    unsafe fn c_new(int value) -> int link_name "yashy_atomic_i64_new";
    unsafe fn c_load(int id, int order) -> int link_name "yashy_atomic_i64_load";
    unsafe fn c_store(int id, int value, int order) link_name "yashy_atomic_i64_store";
    unsafe fn c_fetch_add(int id, int value, int order) -> int link_name "yashy_atomic_i64_fetch_add";
    unsafe fn c_compare_exchange(int id, int expected, int desired, int success, int failure) -> int link_name "yashy_atomic_i64_compare_exchange";
}

pub enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

pub struct AtomicI64 {
    id: int,
}

fn code(Ordering ordering) -> int {
    return switch ordering {
        case Relaxed {
            0
        }
        case Acquire {
            1
        }
        case Release {
            2
        }
        case AcqRel {
            3
        }
        case SeqCst {
            4
        }
    };
}

/// Allocate an atomic slot with its initial value.
pub fn atomic_i64(int initial) -> AtomicI64 {
    return AtomicI64 {
        id: c_new(initial)
    };
}

impl AtomicI64 {
    /// Read the value. `Acquire` and `SeqCst` are the valid read orderings.
    pub fn load(self, Ordering ordering) -> int {
        if ordering matches Ordering.Release || ordering matches Ordering.AcqRel {
            eprint("AcqRel/Release is not a load ordering");
            exit(2);
        }
        return c_load(self.id, code(ordering));
    }

    /// Write the value. `Release` and `SeqCst` are the valid write orderings.
    pub fn store(self, int value, Ordering ordering) {
        if ordering matches Ordering.Acquire || ordering matches Ordering.AcqRel {
            eprint("AcqRel/Acquire is not a store ordering");
            exit(2);
        }
        c_store(self.id, value, code(ordering));
    }

    /// Atomic addition, returning the previous value.
    pub fn fetch_add(self, int value, Ordering ordering) -> int {
        return c_fetch_add(self.id, value, code(ordering));
    }

    /// Compare and swap. Returns the observed value; success means it equals
    /// the expected value.
    pub fn compare_exchange(self, int expected, int desired, Ordering success, Ordering failure) -> int {
        if success matches Ordering.Release || success matches Ordering.Acquire {
            eprint("bad compare_exchange success ordering");
            exit(2);
        }
        if failure matches Ordering.Release || failure matches Ordering.AcqRel {
            eprint("bad compare_exchange failure ordering");
            exit(2);
        }
        return c_compare_exchange(self.id, expected, desired, code(success), code(failure));
    }
}

/// Atomic unsigned 64-bit value. Yashy's `int` carries the bit pattern; the
/// operations never interpret the sign.
pub struct AtomicU64 {
    id: int,
}

/// Allocate an atomic unsigned 64-bit slot.
pub fn atomic_u64(int initial) -> AtomicU64 {
    return AtomicU64 {
        id: c_new(initial)
    };
}

impl AtomicU64 {
    /// Read the unsigned value with an explicit ordering.
    pub fn load(self, Ordering ordering) -> int {
        if ordering matches Ordering.Release || ordering matches Ordering.AcqRel {
            eprint("AcqRel/Release is not a load ordering");
            exit(2);
        }
        return c_load(self.id, code(ordering));
    }

    /// Write the unsigned value with an explicit ordering.
    pub fn store(self, int value, Ordering ordering) {
        if ordering matches Ordering.Acquire || ordering matches Ordering.AcqRel {
            eprint("AcqRel/Acquire is not a store ordering");
            exit(2);
        }
        c_store(self.id, value, code(ordering));
    }

    /// Add to the slot and return its previous unsigned value.
    pub fn fetch_add(self, int value, Ordering ordering) -> int {
        return c_fetch_add(self.id, value, code(ordering));
    }

    /// Swap on equality and return the observed unsigned value.
    pub fn compare_exchange(self, int expected, int desired, Ordering success, Ordering failure) -> int {
        if success matches Ordering.Release || success matches Ordering.Acquire {
            eprint("bad compare_exchange success ordering");
            exit(2);
        }
        if failure matches Ordering.Release || failure matches Ordering.AcqRel {
            eprint("bad compare_exchange failure ordering");
            exit(2);
        }
        return c_compare_exchange(self.id, expected, desired, code(success), code(failure));
    }
}

/// Atomic boolean. Stored as 0 or 1 in an atomic slot.
pub struct AtomicBool {
    id: int,
}

/// Allocate an atomic boolean slot, initially 0 or 1.
pub fn atomic_bool(bool initial) -> AtomicBool {
    const value = switch initial {
        case true {
            1
        }
        default {
            0
        }
    };
    return AtomicBool {
        id: c_new(value)
    };
}

impl AtomicBool {
    /// Read the flag as a boolean with an explicit ordering.
    pub fn load(self, Ordering ordering) -> bool {
        return c_load(self.id, code(ordering)) != 0;
    }

    /// Write the flag as 0 or 1 with an explicit ordering.
    pub fn store(self, bool value, Ordering ordering) {
        const number = switch value {
            case true {
                1
            }
            default {
                0
            }
        };
        c_store(self.id, number, code(ordering));
    }

    /// Swap the flag on equality and return the observed boolean.
    pub fn compare_exchange(self, bool expected, bool desired, Ordering success, Ordering failure) -> bool {
        const want = switch expected {
            case true {
                1
            }
            default {
                0
            }
        };
        const next = switch desired {
            case true {
                1
            }
            default {
                0
            }
        };
        return c_compare_exchange(self.id, want, next, code(success), code(failure)) != 0;
    }
}

/// An atomic opaque handle. A generic `AtomicPtr[T]` needs a phantom type
/// parameter, which the language does not have; the handle is an int slot.
pub struct AtomicPtr {
    id: int,
}

/// Allocate an atomic opaque handle in an integer slot.
pub fn atomic_ptr(int initial) -> AtomicPtr {
    return AtomicPtr {
        id: c_new(initial)
    };
}

impl AtomicPtr {
    /// Read the opaque handle with an explicit ordering.
    pub fn load(self, Ordering ordering) -> int {
        return c_load(self.id, code(ordering));
    }

    /// Write the opaque handle with an explicit ordering.
    pub fn store(self, int value, Ordering ordering) {
        c_store(self.id, value, code(ordering));
    }

    /// Swap the handle on equality and return the observed value.
    pub fn compare_exchange(self, int expected, int desired, Ordering success, Ordering failure) -> int {
        return c_compare_exchange(self.id, expected, desired, code(success), code(failure));
    }
}
