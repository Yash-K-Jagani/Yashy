// JSON scanning without a DOM.
//
// These functions are total: they never answer with a sentinel and never
// panic on malformed input. `minify` removes whitespace outside strings;
// `validate` checks that strings close and brackets balance, returning the
// greatest nesting depth. `tokens` streams the same byte grammar into a flat
// token list with explicit depth and size limits. No value tree is built, so
// a large document can be scanned before a caller decides what to keep.
//
// The token list is parallel `[]int` columns rather than an array of structs:
// the language's arrays hold numbers, `bool` and `string`, so a token's kind
// and byte span are encoded as ints. `at` decodes one column entry back into
// an `Event` for the caller.
//
// `tokens` validates the whole document before it allocates a column, so a
// malformed read answers `Err` without owning anything to release.

/// Why the text is not well-formed at the byte level.
pub enum JsonError {
    /// The byte offset of the first problem.
    Invalid(int),
}

/// A token kind in the streaming reader.
pub enum Token {
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Colon,
    Comma,
    String,
    Number,
    True,
    False,
    Null,
}

/// One token and the byte range it covers.
pub struct Event {
    pub kind: Token,
    pub start: int,
    pub end: int,
}

/// A flat token list: one row per token, in source order.
pub struct TokenList {
    kinds: []int,
    starts: []int,
    ends: []int,
}

impl TokenList {
    /// The number of tokens.
    pub fn len(self) -> int {
        const []int kinds = self.kinds;
        return kinds.len();
    }

    /// Release the three columns.
    pub fn free(self) {
        const []int kinds = self.kinds;
        const []int starts = self.starts;
        const []int ends = self.ends;
        kinds.free();
        starts.free();
        ends.free();
    }
}

/// Explicit caps for a streaming read. A non-positive value is unbounded.
pub struct Limits {
    pub max_depth: int,
    pub max_bytes: int,
}

/// Why a streaming read could not finish.
pub enum StreamError {
    Invalid(int),
    /// The configured depth cap and the depth that breached it.
    TooDeep(int, int),
    /// The configured byte cap and the size that breached it.
    TooLarge(int, int),
}

/// Remove whitespace outside strings, keeping string bytes unchanged.
pub fn minify(string text) -> Result[string, JsonError] {
    let out = "";
    let quoted = false;
    let escaped = false;
    let index = 0;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        const char symbol = byte.to_char();
        if quoted {
            out = out + symbol.to_string();
            if escaped {
                escaped = false;
            } else if byte == 92 {
                escaped = true;
            } else if byte == 34 {
                quoted = false;
            }
        } else if byte == 34 {
            quoted = true;
            out = out + "\"";
        } else if byte != 32 && byte != 9 && byte != 10 && byte != 13 {
            out = out + symbol.to_string();
        }
        index = index + 1;
    }
    if quoted {
        return Err(JsonError.Invalid(index));
    }
    return Ok(out);
}

/// Check string closure and bracket balance; return the maximum depth.
pub fn validate(string text) -> Result[int, JsonError] {
    let depth = 0;
    let greatest = 0;
    let quoted = false;
    let escaped = false;
    let index = 0;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if quoted {
            if escaped {
                escaped = false;
            } else if byte == 92 {
                escaped = true;
            } else if byte == 34 {
                quoted = false;
            }
        } else if byte == 34 {
            quoted = true;
        } else if byte == 91 || byte == 123 {
            depth = depth + 1;
            if depth > greatest {
                greatest = depth;
            }
        } else if byte == 93 || byte == 125 {
            depth = depth - 1;
            if depth < 0 {
                return Err(JsonError.Invalid(index));
            }
        }
        index = index + 1;
    }
    if quoted || depth != 0 {
        return Err(JsonError.Invalid(index));
    }
    return Ok(greatest);
}

/// The end of the string starting at `start`, or `-1` when it never closes.
fn scan_string(string text, int start) -> int {
    let index = start + 1;
    let escaped = false;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if escaped {
            escaped = false;
        } else if byte == 92 {
            escaped = true;
        } else if byte == 34 {
            return index + 1;
        }
        index = index + 1;
    }
    return 0 - 1;
}

/// The end of a JSON number starting at `start`.
fn scan_number(string text, int start) -> int {
    let index = start;
    if index < text.len() && text.byte_at(index).to_int() == 45 {
        index = index + 1;
    }
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        const digit = byte >= 48 && byte <= 57;
        if !digit && byte != 46 && byte != 101 && byte != 69 && byte != 43 && byte != 45 {
            break;
        }
        index = index + 1;
    }
    return index;
}

/// Whether `word` occurs at `start` without running past the end.
fn at_word(string text, int start, string word) -> bool {
    if start + word.len() > text.len() {
        return false;
    }
    return text.slice(start, start + word.len()) == word;
}

/// Validate the byte grammar without allocating. A success means the filling
/// pass cannot fail.
fn check_tokens(string text, Limits limits) -> Option[StreamError] {
    if limits.max_bytes > 0 && text.len() > limits.max_bytes {
        return Some(StreamError.TooLarge(limits.max_bytes, text.len()));
    }
    let depth = 0;
    let index = 0;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            index = index + 1;
            continue;
        }
        if byte == 91 || byte == 123 {
            depth = depth + 1;
            if limits.max_depth > 0 && depth > limits.max_depth {
                return Some(StreamError.TooDeep(limits.max_depth, depth));
            }
            index = index + 1;
            continue;
        }
        if byte == 93 || byte == 125 {
            depth = depth - 1;
            if depth < 0 {
                return Some(StreamError.Invalid(index));
            }
            index = index + 1;
            continue;
        }
        if byte == 58 || byte == 44 {
            index = index + 1;
            continue;
        }
        if byte == 34 {
            const end = scan_string(text, index);
            if end < 0 {
                return Some(StreamError.Invalid(index));
            }
            index = end;
            continue;
        }
        if at_word(text, index, "true") {
            index = index + 4;
            continue;
        }
        if at_word(text, index, "false") {
            index = index + 5;
            continue;
        }
        if at_word(text, index, "null") {
            index = index + 4;
            continue;
        }
        if byte == 45 || (byte >= 48 && byte <= 57) {
            index = scan_number(text, index);
            continue;
        }
        return Some(StreamError.Invalid(index));
    }
    if depth != 0 {
        return Some(StreamError.Invalid(text.len()));
    }
    return None;
}

/// Stream a document into tokens. The token list is flat: no object or array
/// value is built, and the caller sees each token with its byte span.
pub fn tokens(string text, Limits limits) -> Result[TokenList, StreamError] {
    let index = 0;
    const Option[StreamError] problem = check_tokens(text, limits);
    if problem matches Some(_) {
        const StreamError failure = switch problem {
            case Some(value) { value }
            case None { StreamError.Invalid(0) }
        };
        return Err(failure);
    }
    let kinds = []int {};
    let starts = []int {};
    let ends = []int {};
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            index = index + 1;
            continue;
        }
        if byte == 91 || byte == 123 {
            if byte == 91 {
                kinds.push(3);
            } else {
                kinds.push(0);
            }
            starts.push(index);
            ends.push(index + 1);
            index = index + 1;
            continue;
        }
        if byte == 93 || byte == 125 {
            if byte == 93 {
                kinds.push(4);
            } else {
                kinds.push(1);
            }
            starts.push(index);
            ends.push(index + 1);
            index = index + 1;
            continue;
        }
        if byte == 58 {
            kinds.push(5);
            starts.push(index);
            ends.push(index + 1);
            index = index + 1;
            continue;
        }
        if byte == 44 {
            kinds.push(6);
            starts.push(index);
            ends.push(index + 1);
            index = index + 1;
            continue;
        }
        if byte == 34 {
            const end = scan_string(text, index);
            kinds.push(7);
            starts.push(index);
            ends.push(end);
            index = end;
            continue;
        }
        if at_word(text, index, "true") {
            kinds.push(8);
            starts.push(index);
            ends.push(index + 4);
            index = index + 4;
            continue;
        }
        if at_word(text, index, "false") {
            kinds.push(9);
            starts.push(index);
            ends.push(index + 5);
            index = index + 5;
            continue;
        }
        if at_word(text, index, "null") {
            kinds.push(10);
            starts.push(index);
            ends.push(index + 4);
            index = index + 4;
            continue;
        }
        const end = scan_number(text, index);
        kinds.push(2);
        starts.push(index);
        ends.push(end);
        index = end;
    }
    return Ok(TokenList { kinds: kinds, starts: starts, ends: ends });
}

/// Decode one stored kind back into its enum.
fn kind_of(int stored) -> Token {
    if stored == 1 {
        return Token.RightBrace;
    }
    if stored == 3 {
        return Token.LeftBracket;
    }
    if stored == 4 {
        return Token.RightBracket;
    }
    if stored == 5 {
        return Token.Colon;
    }
    if stored == 6 {
        return Token.Comma;
    }
    if stored == 7 {
        return Token.String;
    }
    if stored == 2 {
        return Token.Number;
    }
    if stored == 8 {
        return Token.True;
    }
    if stored == 9 {
        return Token.False;
    }
    if stored == 10 {
        return Token.Null;
    }
    return Token.LeftBrace;
}

/// The token at `index`, or `None` past the end. The event is copied out so
/// the caller does not have to retain the token slice.
pub fn at(TokenList events, int index) -> Option[Event] {
    if index < 0 || index >= events.len() {
        return None;
    }
    const Option[int] stored = events.kinds[index];
    const Option[int] start = events.starts[index];
    const Option[int] end = events.ends[index];
    const int code = switch stored {
        case Some(value) { value }
        case None { 0 }
    };
    const int first = switch start {
        case Some(value) { value }
        case None { 0 }
    };
    const int last = switch end {
        case Some(value) { value }
        case None { 0 }
    };
    return Some(Event { kind: kind_of(code), start: first, end: last });
}
