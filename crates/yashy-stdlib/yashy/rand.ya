// Random numbers (phase 12, Task 10).
//
// The source is the operating system's entropy pool (`BCryptGenRandom` on
// Windows, `getrandom`/`urandom` elsewhere), so the values are unpredictable.
// None of this is a password hash or a cryptographic construction: use the
// platform's crypto library for secrets.
//
// The runtime draws from the OS in blocks, so a program that asks for a
// million numbers makes a few thousand system calls rather than a million.
//
// The API is numeric because Yashy arrays cannot hold every type and `[]u8`
// is a C spelling: `u64()` answers the 64-bit draw in an `int` (the pattern
// is the value; it may be negative when read as signed), `fill(count)` answers
// `[]char` bytes, and `shuffle` reorders a `[]char` in place.
//
// `range(lo, hi)` uses rejection sampling: it discards draws outside a
// multiple of the span, so every value in `lo..hi` is equally likely. A span
// of zero or less answers `lo`; the caller owns the empty interval.
//
// Ownership: `fill` returns a fresh array the caller frees. `shuffle` takes
// ownership of its argument (a slice argument moves): the caller must not use
// or free `data` after the call, and `shuffle` releases it on return.

extern "C" {
    unsafe fn yashy_random_i64() -> int;
}

/// One 64-bit draw from the OS entropy source.
pub fn u64() -> int {
    return yashy_random_i64();
}

/// A uniform value in `lo..hi` (lower bound included, upper excluded).
pub fn range(int lo, int hi) -> int {
    if hi <= lo {
        return lo;
    }
    const span = hi - lo;
    const largest = 9223372036854775807;
    const limit = largest - (largest % span);
    let draw = 0;
    let accepted = false;
    while !accepted {
        const raw = yashy_random_i64();
        draw = raw & largest;
        if draw < limit {
            accepted = true;
        }
    }
    return lo + (draw % span);
}

/// `count` random bytes.
pub fn fill(int count) -> []char {
    let out = []char {};
    let index = 0;
    while index < count {
        const raw = yashy_random_i64();
        const byte = raw & 255;
        out.push(byte.to_char());
        index = index + 1;
    }
    return out;
}

/// Shuffle `data` in place with Fisher-Yates: every permutation is equally
/// likely.
pub fn shuffle([]char data) {
    let index = data.len();
    while index > 1 {
        const other = range(0, index);
        const last = switch data[index - 1] {
            case Some(value) { value }
            case None { (0).to_char() }
        };
        const swap = switch data[other] {
            case Some(value) { value }
            case None { (0).to_char() }
        };
        data.set(index - 1, swap);
        data.set(other, last);
        index = index - 1;
    }
    data.free();
}
