// The environment (phase 12, Task 10).
//
// `vars()` lists every `NAME=VALUE` pair as one element per variable, sorted
// by name: determinism for free -- the order the OS answers in is
// unspecified, so the runtime sorts before joining. `get` is the builtin
// `getenv` answer (`Option[string]`), and `set`/`unset` are views of this
// process's environment; a child inherits its own variables through
// `process.command`, not through these.

import io;

extern "C" {
    unsafe fn yashy_env_join() -> string;
    unsafe fn yashy_env_set(*const u8 name, *const u8 value) -> int;
    unsafe fn yashy_env_unset(*const u8 name) -> int;
}

/** Every variable in the environment as one `"NAME=VALUE"` element, sorted
 * by name. */
pub fn vars() -> []string {
    const text = yashy_env_join();
    return text.lines();
}

/** The value for `name`, or `None` when it is not set. */
pub fn get(string name) -> Option[string] {
    return getenv(name);
}

/** Split one `"NAME=VALUE"` record into its name. */
pub fn name_of(string pair) -> string {
    const equals = pair.index_of("=");
    const at = switch equals {
        case Some(found) { found }
        case None { -1 }
    };
    if at >= 0 {
        return pair.slice(0, at);
    }
    return pair;
}

/** Set `name` to `value` in this process's environment. */
pub fn set(string name, string value) -> Result[int, io.Error] {
    const code = yashy_env_set(name, value);
    if code == 0 {
        return Ok(0);
    }
    return Err(io.Error.Other);
}

/** Remove `name` from this process's environment. */
pub fn unset(string name) -> Result[int, io.Error] {
    const code = yashy_env_unset(name);
    if code == 0 {
        return Ok(0);
    }
    return Err(io.Error.Other);
}
