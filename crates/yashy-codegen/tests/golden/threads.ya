fn work(int n) {
    print(n);
}

fn main() {
    let Mutex m = mutex_new();
    m.lock();
    m.unlock();
    m.free();

    let Channel[int] c = chan_new(2);
    if c.send(1) {
        print(1);
    }
    switch c.recv() {
        case Some(n) {
            print(n)
        }
        case None {
            print(0)
        }
    }
    c.close();
    c.free();

    let int h = thread_spawn(work, 7);
    thread_join(h);
}
