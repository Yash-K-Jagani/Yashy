// Array mutation and ordering methods. `insert` accepts 0..=len and returns
// `false` past the end; `remove` answers `None` out of range. `clear` keeps the
// backing array but sets the length to zero. `reverse` and `sort` update the
// elements in place.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(Option[int] o) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    let xs = []int { 10, 20, 30 };

    if xs.insert(0, 5) {
        print("front ok");
    }
    if xs.insert(2, 15) {
        print("middle ok");
    }
    if xs.insert(xs.len(), 35) {
        print("end ok");
    }
    if xs.insert(xs.len() + 1, 99) {
        print("unexpected: past-end insert accepted");
    } else {
        print("past end rejected");
    }

    print(xs.len());
    print(show(xs.remove(1)));
    print(show(xs.remove(99)));
    print(xs.len());

    for x in xs {
        print(x);
    }

    xs.reverse();
    for x in xs {
        print(x);
    }

    xs.sort();
    for x in xs {
        print(x);
    }

    xs.clear();
    print(xs.len());
    if xs.is_empty() {
        print("cleared");
    }

    xs.free();

    let names = []string { "a", "b" };
    names.clear();
    if names.is_empty() {
        print("strings cleared");
    }
    names.free();
}
