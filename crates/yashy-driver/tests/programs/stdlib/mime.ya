import mime;

fn report(Mime m) {
    print(mime.essence(m));
    print(mime.is_json(m));
    print(mime.is_text(m));
}

fn error_of(string text) -> string {
    const string answer = switch mime.parse_media_type(text) {
        case Ok(_) { "ok" }
        case Err(error) { mime.describe_mime(error) }
    };
    return answer;
}

fn show_param(string text) {
    const Option[string] charset = mime.param(text, "charset");
    switch charset {
        case Some(value) { print("charset=${value}") }
        case None { print("no charset") }
    };
}

fn show_match(string text, string pattern) {
    switch mime.parse_media_type(text) {
        case Ok(m) { print(mime.matches_media(m, text, pattern)) }
        case Err(_) { print("bad") }
    };
}

fn main() {
    switch mime.parse_media_type("application/json; charset=utf-8") {
        case Ok(m) { report(m); }
        case Err(_) { print("bad media type"); }
    };
    show_param("application/json; charset=utf-8");
    show_param("text/plain");
    show_match("application/json; charset=utf-8", "application/*; charset=utf-8");
    show_match("application/json; charset=utf-8", "application/*; charset=ascii");
    show_match("text/plain; charset=utf-8", "text/plain");
    show_match("text/plain", "text/*; charset=utf-8");
    switch mime.parse_media_type("noslash") {
        case Ok(_) { print("accepted"); }
        case Err(_) { print("rejected"); }
    };
    print(error_of("noslash"));
    print(error_of("/json"));
    print(error_of("text/"));
    print(error_of("a/b/c"));
}
