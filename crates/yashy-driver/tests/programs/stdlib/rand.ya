import rand;

fn report_csprng(Result[[]char, CsprngError] answer) -> bool {
    const bool ok = answer matches Ok(_);
    if !ok {
        return false;
    }
    const []char bytes = switch answer {
        case Ok(value) { value }
        case Err(_) { []char {} }
    };
    bytes.free();
    return true;
}

fn main() {
    // The report the deterministic contract promises: `true` under
    // `--deterministic`, `false` for the OS entropy source.
    print("deterministic: ${rand.deterministic()}");
    const bytes = rand.fill(8);
    print("bytes ${bytes.len()}");
    bytes.free();
    print("csprng ${report_csprng(rand.csprng_bytes(8))}");
    print("csprng rejects negative ${rand.csprng_bytes(0-1) matches Err(_)}");
    const value = rand.range(0, 3);
    print("range in 0..3: ${value >= 0 && value < 3}");
    // One raw draw from the OS entropy source. Its value is deliberately not
    // printed: a fuzzable golden must not depend on entropy.
    rand.u64();

    // 1 000 000 draws. A 1% band on the expected count is about seven standard
    // deviations at this size, so the check is stable; at 100 000 draws the
    // same band is two and a bit, which a uniform draw occasionally misses.
    const draws = 1000000;
    let zero = 0;
    let one = 0;
    let two = 0;
    let index = 0;
    while index < draws {
        const draw = rand.range(0, 3);
        if draw == 0 {
            zero = zero + 1;
        }
        if draw == 1 {
            one = one + 1;
        }
        if draw == 2 {
            two = two + 1;
        }
        index = index + 1;
    }
    const expected = draws / 3;
    const tolerance = expected / 100;
    const low = expected - tolerance;
    const high = expected + tolerance;
    print("uniform: ${zero > low && zero < high && one > low && one < high && two > low && two < high}");

    const chars = rand.fill(4);
    rand.shuffle(chars);
    print("shuffle consumed 4");
}
