import iter_adapters;

/// An adapter is a cursor implementing `Iterator`, so `for` drives it and a
/// tuple pattern binds a pair element without copying the underlying slice.
fn iterator_types() {
    // A cursor owns the array header it was built from, so each adapter gets
    // its own array and the header is released through the cursor afterwards.
    let indexed = enumerate_of([]int { 10, 20, 30 });
    for (index, value) in indexed {
        print("i${index}:${value}");
    }
    const indexed_items = indexed.values;
    indexed_items.free();

    let taken = take_of([]int { 10, 20, 30 }, 2);
    for value in taken {
        print("k${value}");
    }
    const taken_items = taken.values;
    taken_items.free();

    let skipped = skip_of([]int { 10, 20, 30 }, 1);
    for value in skipped {
        print("p${value}");
    }
    const skipped_items = skipped.values;
    skipped_items.free();

    let reversed = rev_of([]int { 10, 20, 30 });
    for value in reversed {
        print("q${value}");
    }
    const reversed_items = reversed.values;
    reversed_items.free();

    let pairs = zip_of([]int { 1, 2, 3 }, []int { 7, 8 });
    for (left, right) in pairs {
        print("z${left}:${right}");
    }
    const pair_left = pairs.left;
    const pair_right = pairs.right;
    pair_left.free();
    pair_right.free();

    let linked = chain_of([]int { 1, 2 }, []int { 3, 4 });
    for value in linked {
        print("n${value}");
    }
    const chain_left = linked.left;
    const chain_right = linked.right;
    chain_left.free();
    chain_right.free();

    // An empty first slice has no boundary to skip: the cursor starts on the
    // right-hand slice and stops after it.
    let linked_empty = chain_of([]int {}, []int { 5 });
    for value in linked_empty {
        print("m${value}");
    }
    const empty_left = linked_empty.left;
    const empty_right = linked_empty.right;
    empty_left.free();
    empty_right.free();

    let ranges = chunks_of(3, 2);
    for (start, end) in ranges {
        print("c${start}-${end}");
    }
    let slides = windows_of(3, 2);
    for (start, end) in slides {
        print("w${start}-${end}");
    }
}

// Each adapter walks a slice and calls a visitor in a defined order. Printing
// a line per adapter makes the golden a behavioural proof: a wrong order, a
// missed element or an out-of-range read fails the pinned bytes. The round-trip
// `rev` twice shows the adapter does not consume or corrupt the sequence.
fn main() {
    let xs = []int { 10, 20, 30, 40 };

    xs = iter_adapters.enumerate(xs, |int i, int v| { print("e${i}:${v}"); });
    xs = take(xs, 2, |int v| { print("t${v}"); });
    xs = skip(xs, 2, |int v| { print("s${v}"); });
    xs = rev(xs, |int v| { print("r${v}"); });
    xs = rev(xs, |int v| { print("rr${v}"); });
    xs = chunks(xs, 3, |int a, int b| { print("c${a}-${b}"); });
    xs = windows(xs, 2, |int a, int b| { print("w${a}-${b}"); });
    xs.free();

    let ys = []int { 1, 2, 3 };
    let zs = []int { 7, 8 };
    const pair = zip(ys, zs, |int a, int b| { print("z${a}:${b}"); });
    let zys = pair.left;
    let zzs = pair.right;
    zys.free();
    zzs.free();

    let cs = []int { 1, 2 };
    let ds = []int { 3, 4 };
    const pair2 = chain(cs, ds, |int v| { print("h${v}"); });
    let hcs = pair2.left;
    let hds = pair2.right;
    hcs.free();
    hds.free();

    iterator_types();
}
