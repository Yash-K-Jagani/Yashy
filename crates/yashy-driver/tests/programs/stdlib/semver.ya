import semver;

fn compare_versions(string left, string right) -> int {
    const a = semver.parse_version(left);
    const b = semver.parse_version(right);
    return switch a {
        case Ok(x) {
            switch b {
                case Ok(y) { semver.compare(x, y) }
                case Err(_) { 99 }
            }
        }
        case Err(_) { 99 }
    };
}

fn report(Semver v) {
    print(semver.to_string(v));
    print(semver.compare(v, v));
}

fn error_of(string text) -> string {
    const string answer = switch semver.parse_version(text) {
        case Ok(_) { "ok" }
        case Err(error) { semver.describe_semver(error) }
    };
    return answer;
}

fn main() {
    switch semver.parse_version("1.2.3") {
        case Ok(v) { report(v); }
        case Err(_) { print("bad version"); }
    };
    print(semver.parse_version("1.x.3") matches Err(_));
    switch semver.parse_version("1.0.0-alpha.1") {
        case Ok(v) { print(semver.to_string(v)); }
        case Err(_) { print("bad version"); }
    };
    print(compare_versions("1.0.0-alpha", "1.0.0"));
    print(compare_versions("1.0.0-alpha.1", "1.0.0-alpha.beta"));
    print(compare_versions("1.0.0+build", "1.0.0"));
    print(compare_versions("1.0.0-alpha.2", "1.0.0-alpha.10"));
    print(semver.parse_version("1.0.0-01") matches Err(_));
    print(error_of("1.x.3"));
    print(error_of("1.0"));
    print(error_of("1.2.3.4"));
}
