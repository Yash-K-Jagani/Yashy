import atomic;

fn main() {
    const counter = atomic_i64(1);
    const previous = counter.fetch_add(2, Ordering.SeqCst);
    print(previous == 1);
    counter.store(7, Ordering.Release);
    print(counter.load(Ordering.Acquire) == 7);
    const observed = counter.compare_exchange(
    7,
    8,
    Ordering.SeqCst,
    Ordering.SeqCst
    );
    print(observed == 7);
}
