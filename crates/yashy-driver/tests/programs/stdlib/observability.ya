import observability;

fn capture(string line) {
    print(line);
}

fn main() {
    print(observability.event_json("info", "hello"));
    observability.emit(capture, "error", "bad");
    print(observability.level_text(Level.Warn));
    observability.emit(capture, observability.level_text(Level.Info), "done");
    observability.trace(capture, "t1", "s1", "", "parse", 42);
    observability.metric(capture, "requests", "counter", "3", "route=/health");
    observability.emit_stderr("info", "default sink");
}
