import url;

fn report(Url u) {
    print(url.origin(u));
    print(u.port);
    print(u.path);
}

fn report_full(Url u) {
    print(u.userinfo);
    print(u.host);
    print(u.port);
    print(u.path);
    print(u.query);
    print(u.fragment);
}

fn resolved(string base, string reference) -> string {
    return switch url.resolve(base, reference) {
        case Ok(text) { text }
        case Err(_) { "ERR" }
    };
}

fn main() {
    switch url.parse_url("https://example.org:8443/docs/index.md") {
        case Ok(u) { report(u); }
        case Err(_) { print("bad url"); }
    };
    switch url.percent_decode("a%20b%2Fc") {
        case Ok(decoded) { print(decoded); }
        case Err(_) { print("bad escapes"); }
    };
    switch url.percent_decode("%zz") {
        case Ok(_) { print("unexpected ok"); }
        case Err(_) { print("bad escapes detected"); }
    };

    // Userinfo, IPv6 bracketed host with a port, query and fragment.
    switch url.parse_url("https://alice:pw@[::1]:8080/v1?q=a%20b#frag") {
        case Ok(u) { report_full(u); }
        case Err(_) { print("bad url"); }
    };
    // A bracketed host without a port, and a malformed bracket.
    switch url.parse_url("http://[2001:db8::1]/x") {
        case Ok(u) { print(u.host); }
        case Err(_) { print("bad url"); }
    };
    switch url.parse_url("http://[::1/bad") {
        case Ok(_) { print("unexpected ok"); }
        case Err(_) { print("bad bracket detected"); }
    };

    // Relative reference resolution against a base (RFC 3986 §5.2).
    const base = "http://a.example/b/c/d;p?q";
    print(resolved(base, "g"));
    print(resolved(base, "/g"));
    print(resolved(base, "//g.example/h"));
    print(resolved(base, "../g"));
    print(resolved(base, "../../../g"));
    print(resolved(base, "?y"));
    print(resolved(base, "#s"));
    print(resolved(base, "https://other.example/x"));
}
