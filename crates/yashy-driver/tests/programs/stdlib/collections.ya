import collections;

fn ascending(int left, int right) -> int {
    return left - right;
}

fn unwrap(Option[int] value) -> int {
    return switch value {
        case Some(number) { number }
        case None { -1 }
    };
}

fn bang(string text) -> string {
    return text + "!";
}

fn text_len(string left, string right) -> int {
    return left.len() - right.len();
}

fn unwrap_text(Option[string] value) -> string {
    return switch value {
        case Some(text) { text }
        case None { "none" }
    };
}

fn typed_collections() {
    let v = Vec { items: []int {} };
    v.push(10);
    v.push(20);
    v.push(30);
    const length = v.len();
    const got = unwrap(v.get(1));
    const last = unwrap(v.pop());
    print("vec ${length} ${got} ${last} ${v.len()}");
    v.free();

    let indexed = Vec { items: []int { 5, 6 } };
    let cursor = indexed.enumerate();
    for (index, item) in cursor {
        print("enumerated ${index} ${item}");
    }
    const indexed_items = indexed.items;
    indexed_items.free();

    let s = Set { items: []string {} };
    s.insert("alpha");
    s.insert("beta");
    s.insert("alpha");
    const first = unwrap_text(s.at(0));
    const second = unwrap_text(s.at(1));
    const has = s.contains("alpha");
    print("set ${s.len()} ${first} ${second} ${has}");
    s.free();

    let d = Deque { items: []int {} };
    d.push_back(2);
    d.push_front(1);
    d.push_back(3);
    const front = unwrap(d.front());
    const back = unwrap(d.back());
    const popped_front = unwrap(d.pop_front());
    const popped_back = unwrap(d.pop_back());
    print("deque ${front} ${back} ${popped_front} ${popped_back} ${d.len()}");
    d.free();

    let m = Map {
        keys: []string {},
        values: []string {},
        slots: []int {},
        live: []int {},
    };
    m.put("a", "1");
    m.put("b", "2");
    m.put("a", "9");
    const at_a = unwrap_text(m.get("a"));
    const key0 = unwrap_text(m.key(0));
    const value0 = unwrap_text(m.value(0));
    const key1 = unwrap_text(m.key(1));
    print("map ${m.len()} ${at_a} ${key0} ${value0} ${key1}");
    const removed = unwrap_text(m.remove("b"));
    print("removed ${removed} ${m.len()}");
    const has_a = m.contains_key("a");
    const existing = m.get_or("a", "0");
    const inserted = m.get_or("c", "3");
    m.update("a", bang);
    print("lookups ${has_a} ${existing} ${inserted}");
    let entries = m.iter();
    for entry in entries {
        print("entry ${entry.key}=${entry.value}");
    }
    m.free();

    let pq = PriorityQueue { values: []string {}, heap: []int {}, count: 0 };
    pq.push("bb", text_len);
    pq.push("a", text_len);
    pq.push("aa", text_len);
    pq.push("cc", text_len);
    const pq1 = unwrap_text(pq.pop(text_len));
    const pq2 = unwrap_text(pq.pop(text_len));
    const pq3 = unwrap_text(pq.pop(text_len));
    const pq4 = unwrap_text(pq.pop(text_len));
    print("pq ${pq1} ${pq2} ${pq3} ${pq4} ${pq.len()}");
    pq.free();
}

fn main() {
    // A set is a slice that does not repeat a value. Every operation answers
    // the collection, so the caller binds the answer back, and a question
    // carries the collection with it.
    let set = []int {};
    set = set_insert(set, 3);
    set = set_insert(set, 1);
    set = set_insert(set, 3);
    print("insert dedupes: ${set.len()}");
    const probe = set_contains(set, 3);
    print("contains 3: ${probe.found}");
    set = probe.items;
    set = set_remove(set, 1);
    print("after remove len ${set.len()}");
    set.free();

    // Deque: push at both ends, peek the front, pop from both ends.
    let deque = []int {};
    deque = deque_push_back(deque, 2);
    deque = deque_push_front(deque, 1);
    deque = deque_push_back(deque, 3);
    const peeked = deque_front(deque);
    const peeked_items = peeked.items;
    print("front ${unwrap(peeked.value)} len ${peeked_items.len()}");
    const back_peek = deque_back(peeked_items);
    const front = deque_pop_front(back_peek.items);
    const after_front = front.items;
    const back = deque_pop_back(after_front);
    const rest = back.items;
    print("popped ${unwrap(front.value)} and ${unwrap(back_peek.value)}, rest ${rest.len()}");
    rest.free();

    // Priority queue: the smallest element under the comparator comes out
    // first, and a peek does not remove it.
    let queue = []int {};
    queue = queue_push(queue, 5, ascending);
    queue = queue_push(queue, 1, ascending);
    queue = queue_push(queue, 9, ascending);
    const peeked_queue = queue_peek(queue);
    const kept = peeked_queue.items;
    print("peek ${unwrap(peeked_queue.value)}");
    const smallest = queue_pop(kept, ascending);
    const remaining = smallest.items;
    print("smallest ${unwrap(smallest.value)} rest ${remaining.len()}");
    remaining.free();

    // Insertion sort keeps the slice ordered as values arrive.
    let sorted = []int {};
    sorted = int_sort_insert(sorted, 4);
    sorted = int_sort_insert(sorted, 2);
    sorted = int_sort_insert(sorted, 9);
    const first = switch sorted[0] {
        case Some(value) { value }
        case None { 0 }
    };
    const second = switch sorted[1] {
        case Some(value) { value }
        case None { 0 }
    };
    const third = switch sorted[2] {
        case Some(value) { value }
        case None { 0 }
    };
    print("sorted ${first} ${second} ${third}");
    sorted.free();

    typed_collections();
}
