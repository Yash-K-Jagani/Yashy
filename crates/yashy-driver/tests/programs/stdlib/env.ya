import env;
import string;

/// Lexicographic order on two byte strings: the runtime sorts with this order,
/// so a directory-free environment read can check its own invariant.
fn name_less(string left, string right) -> bool {
    const a = string.to_bytes(left);
    const b = string.to_bytes(right);
    let shorter = a.len();
    if b.len() < shorter {
        shorter = b.len();
    }
    let index = 0;
    let less = false;
    let decided = false;
    // The first differing byte decides: a later byte cannot overrule it, so
    // the loop stops as soon as there is one.
    while index < shorter && !decided {
        const ca = switch a[index] {
            case Some(value) { value.to_int() }
            case None { 0 }
        };
        const cb = switch b[index] {
            case Some(value) { value.to_int() }
            case None { 0 }
        };
        if ca != cb {
            less = ca < cb;
            decided = true;
        }
        index = index + 1;
    }
    if !decided {
        less = a.len() < b.len();
    }
    a.free();
    b.free();
    return less;
}

fn main() {
    switch env.set("YASHY_STDLIB_PROBE", "yes") {
        case Ok(_) { print("set ok") }
        case Err(_) { print("set failed") }
    }
    const seen = env.get("YASHY_STDLIB_PROBE");
    const text = switch seen {
        case Some(value) { value }
        case None { "missing" }
    };
    print("value ${text}");
    switch env.unset("YASHY_STDLIB_PROBE") {
        case Ok(_) { print("unset ok") }
        case Err(_) { print("unset failed") }
    }
    const after = env.get("YASHY_STDLIB_PROBE");
    const still = switch after {
        case Some(_) { true }
        case None { false }
    };
    print("still set: ${still}");

    const all = env.vars();
    let sorted = true;
    let index = 1;
    while index < all.len() {
        const current = switch all[index] {
            case Some(record) { env.name_of(record) }
            case None { "" }
        };
        const previous = switch all[index - 1] {
            case Some(record) { env.name_of(record) }
            case None { "" }
        };
        if name_less(current, previous) {
            sorted = false;
        }
        index = index + 1;
    }
    print("vars sorted: ${sorted}");
    print("vars positive: ${all.len() > 0}");
    all.free();
}
