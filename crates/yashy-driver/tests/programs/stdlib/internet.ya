import mime;
import uuid;
import url;
import semver;
import text;

fn main() {
    switch mime.parse("application/json; charset=utf-8") {
        case Ok(m) {
            print(mime.essence(m));
            print(mime.is_json(m));
            print(mime.is_text(m));
        }
        case Err(e) {
            print("bad media type");
        }
    };
    switch mime.parse("noslash") {
        case Ok(m) {
            print("accepted");
        }
        case Err(e) {
            print("rejected");
        }
    };
    print(uuid.is_valid(uuid.nil()));
    print(uuid.is_valid("not-a-uuid"));
    switch text.hex_decode("00112233445566778899aabbccddeeff") {
        case Ok(bytes) {
            print(uuid.from_bytes(bytes) matches Ok("00112233-4455-6677-8899-aabbccddeeff"));
        }
        case Err(e) {
            print("bad hex");
        }
    };
    switch url.parse("https://example.org:8443/docs/index.md") {
        case Ok(u) {
            print(url.origin(u));
            print(u.port);
            print(u.path);
        }
        case Err(e) {
            print("bad url");
        }
    };
    switch semver.parse("1.2.3") {
        case Ok(v) {
            print(semver.to_string(v));
            print(semver.compare(v, v));
        }
        case Err(e) {
            print("bad version");
        }
    };
    print(semver.parse("1.x.3") matches Err(_));
}
