// Associated functions and the two spellings of a call through a type:
// `Point::new(...)` (type path) and `Point.new(...)` (dotted) resolve to
// one impl and one symbol. A qualified `Show::show(p)` disambiguates.

trait Show {
    fn show(self) -> string;
}

struct Point {
    x: int,
    y: int,
}

impl Point {
    fn new(int x, int y) -> Point {
        return Point { x: x, y: y };
    }
}

impl Show for Point {
    fn show(self) -> string {
        if self.x < 0 {
            return "no";
        }
        return "show";
    }
}

fn main() {
    const a = Point::new(1, 2);
    print(a.x + a.y);

    const b = Point.new(3, 4);
    print(b.x + b.y);

    print(Show::show(a));
}
