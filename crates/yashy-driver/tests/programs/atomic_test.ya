// Atomics with explicit orderings under contention.
import atomic;

fn bump(AtomicI64 counter) {
    let index = 0;
    while index < 1000 {
        counter.fetch_add(1, Ordering.Relaxed);
        index = index + 1;
    }
}

fn main() {
    let counter = atomic.atomic_i64(0);
    let first = thread_spawn(bump, counter);
    let second = thread_spawn(bump, counter);
    thread_join(first);
    thread_join(second);
    const total = counter.load(Ordering.SeqCst);
    assert(total == 2000);

    let published = atomic.atomic_i64(0);
    published.store(42, Ordering.Release);
    const seen = published.load(Ordering.Acquire);
    assert(seen == 42);
    const observed = published.compare_exchange(42, 7, Ordering.AcqRel, Ordering.Relaxed);
    assert(observed == 42);
    assert(published.load(Ordering.SeqCst) == 7);
    let wide = atomic_u64(7);
    assert(wide.fetch_add(5, Ordering.SeqCst) == 7);
    assert(wide.load(Ordering.SeqCst) == 12);

    let flag = atomic_bool(false);
    assert(!flag.load(Ordering.SeqCst));
    flag.store(true, Ordering.Release);
    assert(flag.load(Ordering.Acquire));
    assert(flag.compare_exchange(true, false, Ordering.AcqRel, Ordering.Relaxed));

    let pointer = atomic_ptr(99);
    assert(pointer.load(Ordering.SeqCst) == 99);
    pointer.store(123, Ordering.Release);
    assert(pointer.load(Ordering.Acquire) == 123);
    print("atomic-ok");
}
