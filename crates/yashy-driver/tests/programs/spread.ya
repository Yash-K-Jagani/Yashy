// Spread: a struct literal takes its missing fields from another value, and
// an array literal splices another array's elements in place.
//
// Every printed line is a claim. The first two read the fields a spread
// filled. The next two prove an explicit field wins over the spread. The
// slice lines print the concatenation in order: prefix, spread, suffix, and
// a spread alone. Spreading moves its operand, so each spread gets a fresh
// array of its own.

struct Point {
    x: int,
    y: int,
}

fn show(Option[int] o) -> int {
    if let Some(v) = o {
        return v;
    }
    return 0 - 1;
}

fn main() {
    const base = Point { x: 1, y: 2 };
    const p = Point { x: 9, ..base };
    print(p.x);
    println("");
    print(p.y);
    println("");

    const origin = Point { x: 0, y: 0 };
    const q = Point { ..origin };
    print(q.x);
    println("");
    print(q.y);
    println("");

    let rest = []int { 7, 8 };
    let xs = []int { 0, ..rest, 4 };
    print(xs.len());
    println("");
    print(show(xs[0]));
    println("");
    print(show(xs[1]));
    println("");
    print(show(xs[2]));
    println("");
    print(show(xs[3]));
    println("");
    xs.free();

    let again = []int { 7, 8 };
    let same = [..again];
    print(same.len());
    println("");
    print(show(same[1]));
    println("");
    same.free();
}
