// The checks that make a program safe to read: an error is propagated only
// where it can be, a value-returning function returns on every path, and `&&`
// does not evaluate its right operand when the left one decides.

fn divide(n: int) -> int {
    if n != 0 && 10 / n > 1 {
        return 10 / n;
    }
    return 0;
}

/// Whether the parse produced a number. `None` is "the text is not one".
fn present(value: Option[int]) -> bool {
    return switch value {
        case Some(_) { true }
        case None { false }
    };
}

/// The parsed number. Only read after `present` said there is one.
fn number(value: Option[int]) -> int {
    return switch value {
        case Some(n) { n }
        case None { 0 }
    };
}

/// `parse_i64` says "not a number" as `None`; a `Result`-returning function
/// turns that into the error value its caller expects.
fn parse(s: string) -> Result[int, string] {
    const parsed = s.parse_i64();
    if present(parsed) {
        return Ok(number(parsed));
    }
    return Err("not a number");
}

fn unwrap_or(s: string) -> Result[int, string] {
    const n = parse(s)?;
    return Ok(n);
}

fn main() {
    // The division by zero never happens: `&&` stops at the left operand.
    print(divide(0));
    println("");
    print(divide(2));
    println("");

    const parsed = unwrap_or("41");
    print(switch parsed {
        case Ok(v) { v }
        case Err(e) { 0 }
    });
    println("");
}
