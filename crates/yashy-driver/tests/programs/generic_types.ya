// Generic structs and enums: a scheme is instantiated per argument tuple,
// and each instantiation is an ordinary monomorphic type.

struct Pair[T] {
    first: T,
    second: T,
}

struct Entry[K, V] {
    key: K,
    value: V,
}

fn first[T](Pair[T] p) -> T {
    return p.first;
}

fn main() {
    // One scheme, two instantiations.
    let Pair[int] p = Pair { first: 1, second: 2 };
    print(p.first + p.second);

    let Pair[string] q = Pair { first: "a", second: "b" };
    print(q.first);
    print(q.second);

    // Two type parameters, each inferred from its field's values.
    let Entry[string, int] e = Entry { key: "k", value: 3 };
    print(e.key);
    print(e.value);

    let Entry[string, string] s = Entry { key: "k", value: "v" };
    print(s.value);

    // A generic type inside a generic function: one monomorph per T.
    print(first(Pair { first: 7, second: 8 }));
}
