// Array search, extend, and copy-slice methods. `contains`/`index_of` compare
// element contents, `extend` consumes the array it is given, and `slice`
// copies a clamped range into a fresh array. The `[]string` section checks the
// retain/release path for both extend and slice.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(Option[int] o) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    let xs = []int { 10, 20, 30 };
    if xs.contains(20) {
        print("contains 20");
    }
    if xs.contains(99) {
        print("unexpected: contains 99");
    } else {
        print("missing 99");
    }
    print(show(xs.index_of(30)));
    print(show(xs.index_of(99)));

    xs.extend([]int { 40, 50 });
    print(xs.len());
    for x in xs {
        print(x);
    }

    let part = xs.slice(1, 4);
    for x in part {
        print(x);
    }
    part.free();

    let clamped = xs.slice(0 - 5, 2);
    for x in clamped {
        print(x);
    }
    clamped.free();

    let tail = xs.slice(2, 99);
    for x in tail {
        print(x);
    }
    tail.free();

    xs.free();

    let names = []string { "a", "b" };
    names.extend([]string { "c", "d" });
    if names.contains("c") {
        print("contains c");
    }
    print(show(names.index_of("b")));
    print(names.len());

    let middle = names.slice(1, 3);
    for name in middle {
        print(name);
    }
    middle.free();
    names.free();
}
