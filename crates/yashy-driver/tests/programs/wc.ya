// Lines, words, and bytes over standard input, in the shape of `wc`.
//
// `read_line` strips the terminator, so the byte count adds one per line for the
// newline it removed. A last line without a newline still gets one in the count;
// that matches the common case (a text file ends with a newline) and is the one
// place this program differs from `wc -c`, which counts what is really there.
//
// The word half is `count_words` in `wc_words.ya`, found beside this file.

import wc_words;

/// Whether a line arrived. `None` is end of input; `Some("")` is an empty line,
/// which `wc` counts.
fn present(Option[string] line) -> bool {
    return switch line {
        case Some(_) { true }
        case None { false }
    };
}

/// The text of a line that arrived. Only read after `present` said there is one.
fn text_of(Option[string] line) -> string {
    return switch line {
        case Some(value) { value }
        case None { "" }
    };
}

fn main() {
    let lines = 0;
    let words = 0;
    let bytes = 0;
    let line = read_line();
    while present(line) {
        const text = text_of(line);
        lines = lines + 1;
        words = words + count_words(text);
        bytes = bytes + text.len() + 1;
        line = read_line();
    }

    print(lines);
    print(" ");
    print(words);
    print(" ");
    print(bytes);
    println("");
}
