// String methods. Yashy strings are byte strings, so `len` and `byte_at` count
// bytes, `to_upper`/`to_lower` map ASCII only, and `lines` treats one `\n` as
// one boundary. Every transform returns a fresh owned string.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(Option[int] o) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

/// The word the parse test expects for a parsed float.
fn float_word(float value) -> string {
    if value == 2.5 {
        return "float parse ok";
    }
    return "float parse wrong";
}

fn main() {
    let s = "  Hello, Yashy  ";
    print(s.len());
    if s.is_empty() {
        print("unexpected empty");
    } else {
        print("not empty");
    }

    print(s.byte_at(2));
    print(show(s.get(2)));
    print(show(s.get(99)));

    print(s.slice(2, 7));

    if s.contains("Yashy") {
        print("contains Yashy");
    }
    if s.contains("cat") {
        print("unexpected: contains cat");
    } else {
        print("missing cat");
    }
    if s.starts_with("  He") {
        print("starts He");
    }
    if s.ends_with("  ") {
        print("ends spaces");
    }

    print(show(s.index_of("Yashy")));
    print(show(s.index_of("cat")));

    print(s.trim());
    let trimmed_start = s.trim_start();
    print(trimmed_start.len());
    let trimmed_end = s.trim_end();
    print(trimmed_end.len());
    let upper = s.to_upper();
    print(upper.len());
    print(upper.trim());
    let lower = s.to_lower();
    print(lower.trim());
    let replaced = s.replace("Yashy", "world");
    print(replaced.trim());

    let ab = "ab";
    print(ab.repeat(3));
    let nothing = ab.repeat(0);
    print(nothing.len());

    let csv = "a, b, c";
    let parts = csv.split(", ");
    print(parts.len());
    for part in parts {
        print(part);
    }
    parts.free();

    let one = "abc";
    let whole = one.split("");
    print(whole.len());
    whole.free();

    let trailing = "a,";
    let trailing_parts = trailing.split(",");
    print(trailing_parts.len());
    trailing_parts.free();

    let text = "one\r\ntwo\nthree\n";
    let lines = text.lines();
    print(lines.len());
    for line in lines {
        print(line);
    }
    lines.free();

    let empty = "";
    if empty.is_empty() {
        print("empty is empty");
    }
    let no_lines = empty.lines();
    print(no_lines.len());
    no_lines.free();

    let number = "42";
    print(show(number.parse_i64()));
    let decimal = "2.5";
    switch decimal.parse_f64() {
        case Some(value) { print(float_word(value)) }
        case None { print("float parse wrong") }
    }
}
