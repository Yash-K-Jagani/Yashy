// Array query and update methods. `first`/`last` are `get(0)`/`get(len - 1)`,
// so an empty array answers `None` rather than faulting. `set` returns `false`
// when the index is outside the array, and the array is unchanged.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(Option[int] o) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    let empty = []int {};
    if empty.is_empty() {
        print("empty is empty");
    }
    print(show(empty.first()));
    print(show(empty.last()));

    let xs = []int { 10, 20, 30 };
    if xs.is_empty() {
        print("unexpected: not empty");
    } else {
        print("xs is not empty");
    }
    print(show(xs.get(1)));
    print(show(xs.get(3)));
    print(show(xs.first()));
    print(show(xs.last()));

    if xs.set(1, 99) {
        print("set in range");
    } else {
        print("unexpected: set missed");
    }
    print(show(xs.get(1)));

    if xs.set(3, 1) {
        print("unexpected: set accepted an out-of-range index");
    } else {
        print("set out of range");
    }

    empty.free();
    xs.free();
}
