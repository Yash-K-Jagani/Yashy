// A closure captures the values of the scope it is written in, and carries
// them with it: the closure outlives the function that made it.

fn adder(int n) -> fn(int) -> int {
    return |int x| -> int { return x + n; };
}

fn greeter(string greeting) -> fn() -> string {
    return || -> string { return greeting; };
}

// A trailing block is a lambda in the last argument position. `|x|` writes no
// type: the callee's `fn(int) -> int` parameter supplies it, and the missing
// arrow takes its `int` return the same way.
fn twice(int x, fn(int) -> int f) -> int {
    return f(f(x));
}

fn main() {
    const add5 = adder(5);
    print(add5(10));

    // The closure is still alive after `greeter` has returned: its environment
    // is a block of its own, and the captured string is in it.
    const greet = greeter("hello");
    print(greet());

    // A closure that is made and thrown away: its environment is released
    // with it, so it does not leak.
    |int x| -> int { return x; };

    // The trailing block: `twice` applies its last argument twice, so this
    // adds one twice, from `20` to `22`, with no type written anywhere.
    print(twice(20) { |x| return x + 1; });
}
