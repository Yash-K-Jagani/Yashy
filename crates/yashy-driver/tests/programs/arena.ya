// An arena is a bump allocator: many blocks, one release.
//
// The two allocations stay valid until `arena_free_all`, which is the whole
// point -- `first` is not freed when `second` is handed out, and neither is
// released by a `defer`. Writing and reading through pointer indices proves the
// handle the backend passes is the handle the runtime built.
fn main() {
    let arena = arena_new();

    let first = arena_alloc(arena, 4);
    first[0] = 10;
    first[3] = 32;

    let second = arena_alloc(arena, 2);
    second[0] = 5;

    print(first[0] + first[3] + second[0]);

    arena_free_all(arena);

    arena {
        let buf = alloc(16);
        buf[0] = 1;
        buf[1] = 2;
        let more = alloc(8);
        more[0] = 3;
        print(buf[0] + buf[1] + more[0]);
    }
}
