// Every printable type, printed once. The output is the spec's print table.
struct Point { x: int, y: int }
enum Shape { Circle(float), Empty }

fn main() {
    print("text");
    print('A');
    print(42);
    print(2.5);
    print(true);
    print(Point { x: 3, y: 4 });
    print(Shape.Circle(2.5));
    print((1, true));
    const xs = [1, 2, 3];
    print(xs);
    print(xs[0..2]);
    const Option[int] maybe = Some(7);
    print(maybe);
    const Option[int] missing = None;
    print(missing);
    const Result[int, string] answer = Ok(7);
    print(answer);
    print("1 + 1 = ${1 + 1}");
}
