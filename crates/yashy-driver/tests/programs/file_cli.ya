// A small file tool: read a file, count its lines and words, and write a
// report beside it. It is deliberately ordinary code -- the kind a user writes
// on a Tuesday -- because the verifier's worst failure is refusing a correct
// program. Every owned slice is released on every path out of `main`, and a
// failed read or write is an `io.Error` the program reports rather than an
// empty string or a zero flag it has to guess about.
//
// Usage: file_cli <path>

/// Count words in one line: runs of anything that is not space, tab or
/// carriage return. Written as a scan rather than `split` so the program
/// allocates nothing per line.
fn count_words(string line) -> int {
    let words = 0;
    let in_word = false;
    let index = 0;
    while index < line.len() {
        let byte = line.byte_at(index).to_int();
        let separator = byte == 32 || byte == 9 || byte == 13;
        if separator {
            in_word = false;
        } else {
            if !in_word {
                words = words + 1;
                in_word = true;
            }
        }
        index = index + 1;
    }
    return words;
}

/// Count the lines and words of `body` and write the report beside `path`.
fn report(string path, string body) {
    const lines = body.lines();
    const line_count = lines.len();
    let words = 0;
    for line in lines {
        words = words + count_words(line);
    }
    lines.free();

    const text = "lines=" + str_from_i64(line_count) + " words=" + str_from_i64(words);
    const report_path = path + ".report";
    switch write_file(report_path, text + "\n") {
        case Ok(_) { print(text) }
        case Err(_) { print("file_cli: cannot write " + report_path) }
    }
}

fn main() {
    let arguments = args();
    // Indexing is checked and yields `Option`, so an empty argument list needs
    // no branch of its own; a branch that frees would mark the slice moved for
    // the rest of the function under the checker's conservative join.
    let path = switch arguments[0] {
        case Some(value) { value }
        case None { "" }
    };
    arguments.free();
    if path.len() == 0 {
        print("usage: file_cli <path>");
        return;
    }

    switch read_file(path) {
        case Ok(body) { report(path, body) }
        case Err(_) { print("file_cli: cannot read " + path) }
    }
}
