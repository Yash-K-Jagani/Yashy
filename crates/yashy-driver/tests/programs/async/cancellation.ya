// Cancellation: the scope spawns a worker and never awaits it, so the
// join-or-cancel at scope exit runs it to completion on the cancel path
// and the deferred print happens before main answers 5.
fn worker() -> int {
    defer {
        print("closed");
    }
    return 7;
}

async fn main_task() -> int {
    scope {
        spawn(worker);
    }
    return 5;
}

fn main() {
    print(block_on(main_task()));
}
