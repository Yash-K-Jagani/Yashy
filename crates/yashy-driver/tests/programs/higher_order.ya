// The higher-order array methods: `map`, `filter`, and `fold`.
//
// Each one calls a function on the array's elements, so each one is a loop
// that a lambda is called from.

fn main() {
    let xs = []int { 1, 2, 3 };

    // `map` builds a new array: the source keeps its own elements.
    let doubled = xs.map(|int x| -> int { return x * 2; });
    for x in doubled {
        print(x);
    }
    doubled.free();

    // `filter` keeps the elements that pass.
    let big = xs.filter(|int x| -> bool { return x > 2; });
    for x in big {
        print(x);
    }
    big.free();

    // `fold` carries one value through the whole array.
    print(xs.fold(0, |int acc, int x| -> int { return acc + x; }));

    // The element type may change: `[]int` maps to `[]string`.
    let texts = xs.map(|int x| -> string { return str_from_i64(x); });
    for text in texts {
        print(text);
    }
    texts.free();

    xs.free();
}
