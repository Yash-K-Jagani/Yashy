// Counts the quoted keys of a JSON-ish document, one key per line, read from
// standard input until end of input.
//
// The program is the M6 container proof: an `[]string` accumulates the lines, a
// `map[string]int` deduplicates the keys, `for` walks the slice, and the last two
// statements release both containers. Feeding it:
//
//     {"name": "yashy"}
//     {"age": 3}
//     {"name": "again"}
//
// prints 3 (keys seen) and 2 (distinct keys).
//
// `key_of` lives in `json_keys.ya`; `import` searches the entry file's directory,
// so the second file is found without any path configuration.

import json_keys;

/// Whether a line arrived. `None` is end of input; `Some("")` is an empty line.
fn present(Option[string] line) -> bool {
    return switch line {
        case Some(_) { true }
        case None { false }
    };
}

/// The text of a line that arrived. Only read after `present` said there is one.
fn text_of(Option[string] line) -> string {
    return switch line {
        case Some(value) { value }
        case None { "" }
    };
}

fn main() {
    let lines = []string {};
    let line = read_line();
    while present(line) {
        lines.push(text_of(line));
        line = read_line();
    }

    let map[string]int keys = map_new();
    let seen = 0;
    for text in lines {
        let key = key_of(text);
        // A line with no quoted pair yields an empty key, which is not a key
        // this program counts. An empty JSON key (`"": 1`) is skipped too; the
        // trade is documented rather than hidden behind an `Option`.
        if key.len() > 0 {
            keys.insert(key, 1);
            seen = seen + 1;
        }
    }

    print(seen);
    print(keys.len());

    lines.free();
    keys.free();
}
