// E1511: `Iterator` is the compiler-known `for` protocol and cannot be
// re-declared as a user trait. The sealed protocol is what keeps the typestate
// rule about calling `next()` after `None` honest.
trait Iterator { fn next(self: *mut Self) -> Option[int]; }

struct Counter { n: int }

impl Iterator for Counter {
    fn next(self: *mut Self) -> Option[int] {
        if self[0].n <= 0 { return None; }
        self[0].n = self[0].n - 1;
        return Some(self[0].n);
    }
}

fn main() {
    let c = Counter { n: 1 };
    print(c.n);
    if let None = c.next() {
        if let Some(z) = c.next() { print(z); }
    }
    print(0);
}
