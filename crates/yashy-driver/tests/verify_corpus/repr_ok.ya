// A `repr(C)` struct with the layout queries: the answers are constants the
// checker computed, so there is no obligation for the verifier to prove and
// nothing for it to report.
//
// Expected: the program is accepted and produces no codes.
repr(C) struct Pair {
    a: u8,
    b: i32,
}

fn main() {
    print(sizeof(Pair));
    print(" ");
    print(alignof(Pair));
    print(" ");
    print(offsetof(Pair, b));
    print("");
}
