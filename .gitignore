# Superpowers scratch (SDD ledgers, briefs, review packages)
.superpowers/

# Build output
target/
dist/
# Per-project debugger scratch written by `yashy run` under the program's directory.
.yashy/
# Benchmark binaries and their intermediate IR/objects: all build output, and
# the patterns below already cover the file types. Listed for clarity.
benchmarks/build/
# Generated IR is build output, but golden expectations are tracked.
*.ll
!*.expected.ll
*.o
*.obj
*.exe
*.pdb
*.ilk
*.lib

# Test artifacts
tests/programs/**/out

# Gate runner output: one log per gate, plus the nightly JSON summary.
# Scratch, never committed.
.gates-*.log
.gates-nightly.json