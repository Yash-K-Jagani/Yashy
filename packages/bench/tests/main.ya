// The bench package.
import bench;

fn work() -> int {
    let total = 0;
    let index = 0;
    while index < 100 {
        total = total + index;
        index = index + 1;
    }
    return total;
}

fn main() {
    const elapsed = bench.run("work", 10, work);
    assert(elapsed >= 0);
    print("bench-ok");
}
