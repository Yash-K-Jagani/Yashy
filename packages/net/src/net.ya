// TCP sockets (phase 12, Task 5).
//
// `net_listen`, `net_accept` and `net_connect` return linear handles; the
// typestate pass tracks each binding as `Open` until `net_close` moves it to
// `Closed`. A second close is `E1400`, and any later use is `E1401`.
// `net_read` answers `Some(text)` for bytes, `None` for a clean EOF, and
// `Err` for a failed socket; it never invents empty bytes to mean failure.
// `net_write` sends every byte and answers the count it sent.
//
// Every operation is effectful and a `pure fn` cannot open a socket (`E1300`).
// Ownership: handles are moved into the operation that uses them; a read or
// write does not release the socket. Close each handle exactly once.

extern "C" {
    unsafe fn yashy_tcp_listen(* const u8 host, i64 port) -> i64;
    unsafe fn yashy_tcp_accept(i64 listener) -> i64;
    unsafe fn yashy_tcp_connect(* const u8 host, i64 port) -> i64;
    unsafe fn yashy_tcp_read_str(i64 fd, i64 max) -> string;
    unsafe fn yashy_tcp_write(i64 fd, * const u8 buf, i64 len) -> i64;
    unsafe fn yashy_tcp_close(i64 fd) -> void;
    unsafe fn yashy_tcp_set_timeout(i64 fd, i64 millis) -> i64;
    unsafe fn yashy_net_last_error() -> int;
    unsafe fn yashy_net_set_deadline(i64 fd, i64 at_ms) -> i64;
    unsafe fn yashy_tcp_cancel(i64 fd) -> void;
}

pub struct Listener {
    fd: int,
}

pub struct Socket {
    fd: int,
}

pub enum NetError {
    /// The peer refused the connection.
    Refused,
    /// The peer reset the connection.
    Reset,
    /// An absolute deadline passed before the call could complete.
    Timeout,
    /// The operation was cancelled and its socket was closed.
    Cancelled,
    /// The name could not be resolved.
    Dns,
    /// The local address was already in use.
    AddressInUse,
    /// The socket was already closed.
    Closed,
    /// A cause the runtime does not classify more finely.
    Other,
    /// Kept for callers of the original one-variant spelling.
    Failure,
}

/// Render a network error as a stable sentence.
pub fn net_describe(NetError error) -> string {
    return switch error {
        case Refused { "connection refused" }
        case Reset { "connection reset" }
        case Timeout { "operation timed out" }
        case Cancelled { "operation cancelled" }
        case Dns { "name resolution failed" }
        case AddressInUse { "address already in use" }
        case Closed { "socket already closed" }
        case Other { "socket failure" }
        case Failure { "socket failure" }
    };
}

/// Read and clear the last socket error. A successful operation clears it.
/// Read and clear the raw last-error code, for sibling network modules.
pub fn take_error_code() -> int {
    return yashy_net_last_error();
}

/// Read and clear the last socket error, for sibling network modules.
pub fn take_error() -> NetError {
    const code = yashy_net_last_error();
    return switch code {
        case 1 { NetError.Refused }
        case 2 { NetError.Reset }
        case 3 { NetError.Timeout }
        case 4 { NetError.Cancelled }
        case 5 { NetError.Dns }
        case 6 { NetError.AddressInUse }
        case 7 { NetError.Other }
        case 8 { NetError.Closed }
        default { NetError.Failure }
    };
}

pub unsafe fn net_listen(string host, int port) -> Result[Listener, NetError] {
    const fd = yashy_tcp_listen(host, port);
    if fd < 0 {
        return Err(take_error());
    }
    return Ok(Listener {
        fd: fd
    }
    );
}

pub unsafe fn net_accept(Listener listener) -> Result[Socket, NetError] {
    const fd = yashy_tcp_accept(listener.fd);
    if fd < 0 {
        return Err(take_error());
    }
    return Ok(Socket {
        fd: fd
    }
    );
}

pub unsafe fn net_connect(string host, int port) -> Result[Socket, NetError] {
    const fd = yashy_tcp_connect(host, port);
    if fd < 0 {
        return Err(take_error());
    }
    return Ok(Socket {
        fd: fd
    }
    );
}

pub unsafe fn net_read(Socket peer) -> Result[Option[string], NetError] {
    const encoded = yashy_tcp_read_str(peer.fd, 4096);
    if encoded.len() == 0 {
        return Err(NetError.Failure);
    }
    const status = encoded.byte_at(0).to_int();
    if status == 0 {
        const Option[string] nothing = None;
        return Ok(nothing);
    }
    if status != 1 {
        return Err(take_error());
    }
    return Ok(Some(encoded.slice(1, encoded.len())));
}

pub unsafe fn net_write(Socket peer, string data) -> Result[int, NetError] {
    const sent = yashy_tcp_write(peer.fd, data, data.len());
    if sent < 0 {
        return Err(take_error());
    }
    return Ok(sent);
}

pub unsafe fn net_close(Socket peer) {
    yashy_tcp_close(peer.fd);
}

pub unsafe fn net_set_timeout(Socket peer, int millis) -> Result[int, NetError] {
    const code = yashy_tcp_set_timeout(peer.fd, millis);
    if code != 0 {
        return Err(NetError.Failure);
    }
    return Ok(code);
}

pub unsafe fn net_close_listener(Listener listener) {
    yashy_tcp_close(listener.fd);
}

/// Cancel work on a socket and close it. A later read answers
/// `Err(Cancelled)`, a cause distinct from `Timeout` and `Closed`.
pub unsafe fn net_cancel(Socket peer) -> Result[int, NetError] {
    yashy_tcp_cancel(peer.fd);
    return Err(NetError.Cancelled);
}

/// Close a raw socket handle held by a sibling network module.
pub unsafe fn net_close_fd(int fd) {
    yashy_tcp_close(fd);
}

/// Set an absolute deadline (Unix milliseconds) for a socket. A read or write
/// that starts after the instant answers `Err(Timeout)`; the deadline does not
/// reset on each call, so a slow peer cannot extend it.
pub unsafe fn net_set_deadline(Socket peer, int at_ms) -> Result[int, NetError] {
    const code = yashy_net_set_deadline(peer.fd, at_ms);
    if code != 0 {
        return Err(take_error());
    }
    return Ok(code);
}
