// Parameter-bound SQL fragments.
//
// A query is SQL text with `?` placeholders and a separate parameter list.
// Values are never spliced into the SQL: a value containing `;` or a quote is
// data, not syntax. The builder checks that the placeholder count matches the
// parameter count and refuses an empty statement. It does not execute anything.

/// Why a query could not be built.
pub enum DbError {
    /// The number of `?` placeholders did not match the parameter count.
    Arity(int, int),
    /// The SQL text was empty.
    Empty,
    /// An identifier contained a character outside its closed grammar.
    InvalidIdentifier,
}

/// A validated table identifier. Its name is ASCII letters, digits and
/// underscores, starting with a letter, and at most 64 bytes. A quote, a
/// semicolon, a space or a dot cannot be represented here.
pub struct Table {
    name: string,
}

/// A validated column identifier, with the same grammar as a table.
pub struct Column {
    name: string,
}

/// A validated comma-separated column list. Its text is built only by
/// `columns`, which checks every name, so an injected comma cannot add an
/// expression to a `SELECT`.
pub struct Columns {
    text: string,
}

/// Validate a comma-separated list of column names, or `None` when any name
/// is not a bare identifier.
pub fn columns(string comma_separated) -> Option[Columns] {
    const parts = comma_separated.split(",");
    let result = "";
    let index = 0;
    let bool valid = true;
    while index < parts.len() && valid {
        const part = switch parts[index] {
            case Some(value) {
                value.trim()
            }
            case None {
                ""
            }
        };
        if !identifier(part) {
            valid = false;
        } else {
            if index > 0 {
                result = result + ", ";
            }
            result = result + part;
        }
        index = index + 1;
    }
    parts.free();
    if !valid || result.len() == 0 {
        return None;
    }
    return Some(Columns {
        text: result
    }
    );
}

/// The closed set of directions a dynamic `ORDER BY` can ask for.
pub enum Order {
    Asc,
    Desc,
}

/// A sort request. The column is a validated identifier and the direction is
/// a closed enum, so no caller-supplied text reaches the SQL.
pub struct Sort {
    column: Column,
    direction: Order,
}

/// Validate a table name, or `None` when it is not a bare identifier.
pub fn table(string name) -> Option[Table] {
    if !identifier(name) {
        return None;
    }
    return Some(Table {
        name: name
    }
    );
}

/// Validate a column name, or `None` when it is not a bare identifier.
pub fn column(string name) -> Option[Column] {
    if !identifier(name) {
        return None;
    }
    return Some(Column {
        name: name
    }
    );
}

/// Make a sort request from a validated column and a closed direction.
pub fn sort(Column by, Order direction) -> Sort {
    return Sort {
        column: by, direction: direction
    };
}

/// The shared identifier grammar. A bare name starts with a letter and then
/// uses letters, digits or underscores; a dot is refused so a caller cannot
/// smuggle a qualified name through either newtype.
fn identifier(string text) -> bool {
    if text.len() == 0 || text.len() > 64 {
        return false;
    }
    const first = text.byte_at(0).to_int();
    if !letter(first) {
        return false;
    }
    let index = 1;
    while index < text.len() {
        const byte = text.byte_at(index).to_int();
        if !letter(byte) && !(byte >= 48 && byte <= 57) && byte != 95 {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn letter(int byte) -> bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);
}

/// A checked query: SQL with placeholders, and the bound values in order.
pub struct Query {
    sql: string,
    params: []string,
}

/// Build a query from SQL text and one value per `?`.
pub fn build(string sql, []string params) -> Result[Query, DbError] {
    if sql.len() == 0 {
        return Err(DbError.Empty);
    }
    const placeholders = count(sql, '?');
    if placeholders != params.len() {
        return Err(DbError.Arity(placeholders, params.len()));
    }
    return Ok(Query {
        sql: sql, params: params
    }
    );
}

/// The SQL text. Placeholders stay in it; execution binds the parameters.
pub fn sql(Query query) -> string {
    const sql = query.sql;
    return sql.slice(0, sql.len());
}

/// The bound values, in placeholder order.
pub fn params(Query query) -> []string {
    return query.params;
}

/// Build a `SELECT` from validated identifiers and a caller-written `WHERE`.
///
/// `where_sql` is SQL with `?` placeholders, never a place for a value; values
/// belong in `params` and stay bound. Pass `""` for no `WHERE` clause. An empty
/// column list or an unvalidated identifier is refused.
pub fn select(
Table from,
Columns selected,
string where_sql,
[]string params,
Option[Sort] ordering,
) -> Result[Query, DbError] {
    const selected_text = selected.text;
    if selected_text.len() == 0 {
        return Err(DbError.Empty);
    }
    let sql = "SELECT " + selected_text + " FROM " + from.name;
    if where_sql.len() > 0 {
        sql = sql + " WHERE " + where_sql;
    }
    sql = sql + order_clause(ordering);
    return build(sql, params);
}

fn direction_word(Order direction) -> string {
    return switch direction {
        case Order.Asc {
            " ASC"
        }
        case Order.Desc {
            " DESC"
        }
    };
}

fn sort_clause(Sort request) -> string {
    const word = direction_word(request.direction);
    const column = request.column;
    return " ORDER BY " + column.name + word;
}

/// The dynamic tail of a `SELECT`, built only from a closed enum.
fn order_clause(Option[Sort] ordering) -> string {
    return switch ordering {
        case Some(request) {
            sort_clause(request)
        }
        case None {
            ""
        }
    };
}

/// One predicate. Its SQL is built only from a validated column name and a
/// closed operator; the values stay in the bound parameter list.
pub struct Expr {
    text: string,
}

/// `column = ?`
pub fn eq(Column column) -> Expr {
    return Expr {
        text: column.name + " = ?"
    };
}

/// `column > ?`
pub fn gt(Column column) -> Expr {
    return Expr {
        text: column.name + " > ?"
    };
}

/// `column IN (?, ?, ...)`, with one placeholder per element.
pub fn in_list(Column column, int count) -> Expr {
    if count < 1 || count > 64 {
        return Expr {
            text: "invalid IN list"
        };
    }
    let slots = "";
    let index = 0;
    while index < count {
        if index > 0 {
            slots = slots + ", ";
        }
        slots = slots + "?";
        index = index + 1;
    }
    return Expr {
        text: column.name + " IN (" + slots + ")"
    };
}

/// An ordered set of predicates, joined with ` AND `.
pub struct Filters {
    text: string,
}

/// No predicates.
pub fn no_filters() -> Filters {
    return Filters {
        text: ""
    };
}

/// Add one predicate.
pub fn add_filter(Filters filters, Expr predicate) -> Filters {
    const prior = filters.text;
    if prior.len() == 0 {
        return Filters {
            text: predicate.text
        };
    }
    return Filters {
        text: prior + " AND " + predicate.text
    };
}

/// A full SELECT: validated identifiers, `?` placeholders, one bound value per
/// placeholder, an optional closed-enum ordering and an optional row limit.
pub fn select_where(
Table from,
Columns selected,
Filters filters,
Option[Sort] ordering,
int row_limit,
[]string params,
) -> Result[Query, DbError] {
    const chosen = selected.text;
    if chosen.len() == 0 {
        return Err(DbError.Empty);
    }
    let sql = "SELECT " + chosen + " FROM " + from.name;
    const where_sql = filters.text;
    if where_sql.len() > 0 {
        sql = sql + " WHERE " + where_sql;
    }
    sql = sql + order_clause(ordering);
    if row_limit > 0 {
        sql = sql + " LIMIT " + str_from_i64(row_limit);
    }
    return build(sql, params);
}

/// Count a byte in a string.
fn count(string text, char wanted) -> int {
    const target = wanted.to_int();
    let total = 0;
    let index = 0;
    while index < text.len() {
        if text.byte_at(index).to_int() == target {
            total = total + 1;
        }
        index = index + 1;
    }
    return total;
}
