// Password hashing with a per-password salt.
//
// The primitive is the vendored SHA-512 from the crypto package with a fresh
// random salt. Argon2id is the recommended KDF and is carried forward: it is
// not available in this checkout's pinned primitives.

import crypto;

import rand;

import text;

/// A stored password: salt and digest, both hex.
pub struct Hash {
    salt: string,
    digest: string,
}

fn random_hex() -> string {
    const bytes = rand.fill(16);
    return text.base64url_encode(bytes);
}

fn password_digest(string salt, string password) -> string {
    return switch crypto.sha512_hex(salt + ":" + password) {
        case Ok(value) {
            value
        }
        case Err(_) {
            ""
        }
    };
}

/// Hash a password with a fresh random salt.
pub fn hash(string password) -> Hash {
    const salt = random_hex();
    return Hash {
        salt: salt, digest: password_digest(salt, password)
    };
}

/// Verify a password against a stored hash in constant time over the digest.
pub fn check(Hash stored, string password) -> bool {
    return password_eq(stored.digest, password_digest(stored.salt, password));
}

fn password_eq(string left, string right) -> bool {
    if left.len() != right.len() {
        return false;
    }
    let int difference = 0;
    let index = 0;
    while index < left.len() {
        difference = difference | (left.byte_at(index).to_int() ^ right.byte_at(index).to_int());
        index = index + 1;
    }
    return difference == 0;
}
