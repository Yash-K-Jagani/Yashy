// CSRF tokens.
//
// A token is a digest of a per-session secret and a per-form nonce. The nonce
// is generated by the caller and echoed back in the form, so a site cannot
// forge a token without the secret. Comparison is constant-time.

import hash;

import text;

import string;

/// Compare two strings without an early exit on the first difference.
pub fn csrf_eq(string left, string right) -> bool {
    let different = 0;
    let shorter = left.len();
    if right.len() < shorter {
        shorter = right.len();
    }
    let index = 0;
    while index < shorter {
        different = different | (left.byte_at(index).to_int() ^ right.byte_at(index).to_int());
        index = index + 1;
    }
    different = different | (left.len() ^ right.len());
    return different == 0;
}

/// The token for a secret and nonce, as base64url text.
pub fn token(string secret, string nonce) -> string {
    const bytes = string.to_bytes(secret + "." + nonce);
    const sum = hash.sha256(bytes);
    const hex = text.hex_encode(sum);
    return text.base64url_encode(string.to_bytes(hex));
}

/// Whether a presented token matches the one for this secret and nonce.
pub fn valid(string secret, string nonce, string presented) -> bool {
    return csrf_eq(presented, token(secret, nonce));
}
