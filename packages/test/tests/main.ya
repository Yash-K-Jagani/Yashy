// The test package.
import test;
import table;
import property;

fn always_even(int value) -> bool {
    return value % 2 == 0;
}

fn main() {
    test_assert_eq("hello", "hello", "same-value");
    test_assert_contains("hello world", "world", "substring");
    const cases = []string { "one", "two" };
    const results = []bool { true, false };
    const failed = run_table(cases, results);
    test_assert_eq("1", str_from_i64(failed), "table failures");
    const counterexample = run_property(always_even, 7, 100);
    if counterexample >= 0 && counterexample % 2 == 0 {
        test_fail("property", "a counter-example must violate the property");
    }
    print("test-ok");
}
