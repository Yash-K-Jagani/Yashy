// The test package.
import test;
import table;
import property;
import snapshot;
import mock;

fn always_even(int value) -> bool {
    return value % 2 == 0;
}

fn bad_result() -> Result[int, string] {
    return Err("bad input");
}

fn main() {
    test_assert_eq("hello", "hello", "same-value");
    test_assert_contains("hello world", "world", "substring");
    expect_eq_int(2 + 2, 4, "integer assertion");
    expect_eq_bool(true, true, "boolean assertion");
    expect_approx(1.0, 1.0000001, 0.0001, "approximate assertion");
    expect_eq_int(expect_some_int(Some(7), "some assertion"), 7, "unwrapped value");
    expect_none_int(None, "none assertion");
    const error = expect_err(bad_result(), "error assertion");
    assert(error == "bad input");
    const cases = []string { "one", "two" };
    const results = []bool { true, false };
    const failed = run_table(cases, results);
    test_assert_eq("1", str_from_i64(failed), "table failures");
    const counterexample = run_property(always_even, 7, 100);
    if counterexample >= 0 && counterexample % 2 == 0 {
        test_fail("property", "a counter-example must violate the property");
    }
    const found = find(always_even, 7, 100);
    switch found {
        case Some(failure) {
            assert(describe(failure).contains("seed=7"));
            assert(failure.value % 2 != 0);
            assert(failure.original % 2 != 0);
            assert(failure.index >= 0);
        }
        case None {
            test_fail("property", "expected an odd counter-example");
        }
    };
    if !expect_snapshot("packages/test/tests/snapshot.txt", "one\ntwo\n") {
        test_fail("snapshot", "the snapshot must match");
    }
    let calls = mock.new();
    calls = mock.record(calls, "open", "file.txt");
    calls = mock.record(calls, "close", "");
    assert(mock.called(calls, "open") && mock.called(calls, "close"));
    assert(mock.count(calls) == 2);
    assert(mock.log(calls).contains("open(file.txt)"));
    print("test-ok");
}
