// Mocks are explicit values, not global registries.
//
// A test constructs a mock, passes it to the code under test and reads the
// calls it recorded afterwards. There is no hidden injection and no ambient
// state, so two tests in one process cannot see each other's calls.

/// The requirement a code-under-test asks for when it needs to record a call.
///
/// The mock implements this trait, so a test can pass it to a function bounded
/// by `Recorder` without a global registry or a hidden injection hook.
pub trait Recorder {
    fn record(self: *mut Self, string name, string args);
}

/// A recorded call log, one `name(args)` line per call.
pub struct Mock {
    calls: string,
}

impl Recorder for Mock {
    fn record(self: *mut Self, string name, string args) {
        self[0].calls = self[0].calls + name + "(" + args + ")\n";
    }
}

/// A fresh mock with no calls.
pub fn new() -> Mock {
    return Mock { calls: "" };
}

/// Record one call, returning the updated mock.
pub fn record(Mock mock, string name, string args) -> Mock {
    return Mock {
        calls: mock.calls + name + "(" + args + ")\n",
    };
}

/// Hand a recorder to code that knows only the requirement, not the mock.
/// The bound is checked at the call site, so the body needs no concrete type.
pub fn record_pair[T: Recorder](T recorder, string first, string second) {
    let local = recorder;
    local.record(first, "");
    local.record(second, "");
}

/// The recorded log, in call order.
pub fn log(Mock mock) -> string {
    return mock.calls;
}

/// Whether a call to `name` was recorded.
pub fn called(Mock mock, string name) -> bool {
    return mock.calls.contains(name + "(");
}

/// How many calls were recorded.
pub fn count(Mock mock) -> int {
    if mock.calls.len() == 0 {
        return 0;
    }
    const lines = mock.calls.trim().split("\n");
    const total = lines.len();
    lines.free();
    return total;
}
