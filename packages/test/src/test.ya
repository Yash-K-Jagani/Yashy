// Assertions for test programs (phase 12, Task 7).
//
// `assert_eq` and `assert_contains` print a diff and exit non-zero when
// their check fails; `fail` always does. This is the library form of what
// the harness already does, so a test program can use the same wording
// inside a helper function instead of inlining assertions everywhere.

pub fn test_assert_eq(string actual, string expected, string label) {
    if actual != expected {
        print("FAIL ${label}");
        print("  expected: ${expected}");
        print("  actual:   ${actual}");
        exit(1);
    }
}

pub fn test_assert_contains(string haystack, string needle, string label) {
    if !haystack.contains(needle) {
        print("FAIL ${label}");
        print("  expected to contain: ${needle}");
        print("  actual: ${haystack}");
        exit(1);
    }
}

pub fn test_fail(string label, string detail) {
    print("FAIL ${label}");
    print("  ${detail}");
    exit(1);
}

// Typed assertion helpers. Each one names the check and renders the expected
// and actual values in the failure, so a log says what was wrong rather than
// only that something was. The concrete spellings are deliberate: there is no
// `Debug` trait in the language yet, so a generic `expect_eq[T]` cannot render
// an arbitrary value without a display bound.

/// Expect two integers to match.
pub fn expect_eq_int(int actual, int expected, string label) {
    if actual != expected {
        print("FAIL ${label}");
        print("  expected: ${expected}");
        print("  actual:   ${actual}");
        exit(1);
    }
}

/// Expect two booleans to match.
pub fn expect_eq_bool(bool actual, bool expected, string label) {
    if actual != expected {
        print("FAIL ${label}");
        print("  expected: ${expected}");
        print("  actual:   ${actual}");
        exit(1);
    }
}

/// Expect two floats to match within a tolerance.
pub fn expect_approx(float actual, float expected, float tolerance, string label) {
    const delta = actual - expected;
    if delta < (0.0 - tolerance) || delta > tolerance {
        print("FAIL ${label}");
        print("  expected: ${expected} +/- ${tolerance}");
        print("  actual:   ${actual}");
        exit(1);
    }
}

/// Expect an integer `Option` to hold a value; return it.
pub fn expect_some_int(Option[int] actual, string label) -> int {
    if let Some(value) = actual {
        return value;
    }
    test_fail(label, "expected Some(int), found None");
    return 0;
}

/// Expect an integer `Option` to be empty.
pub fn expect_none_int(Option[int] actual, string label) {
    if let Some(value) = actual {
        print("FAIL ${label}");
        print("  expected: None");
        print("  actual:   Some(${value})");
        exit(1);
    }
}

/// Expect a `Result[int, string]` to be an error; return the message.
pub fn expect_err(Result[int, string] actual, string label) -> string {
    if let Err(message) = actual {
        return message;
    }
    if let Ok(value) = actual {
        print("FAIL ${label}");
        print("  expected: Err(_)");
        print("  actual:   Ok(${value})");
        exit(1);
    }
    return "";
}

/// Expect two strings to match, rendering both sides on failure.
pub fn expect_eq_string(string actual, string expected, string label) {
    if actual != expected {
        print("FAIL ${label}");
        print("  expected: ${expected}");
        print("  actual:   ${actual}");
        exit(1);
    }
}

/// Expect a string option to be `Some`, returning its value.
pub fn expect_some_string(Option[string] actual, string label) -> string {
    if let Some(value) = actual {
        return value;
    }
    print("FAIL ${label}");
    print("  expected: Some(string)");
    print("  actual:   None");
    exit(1);
    return "";
}

/// Expect a string option to be `None`.
pub fn expect_none_string(Option[string] actual, string label) {
    if let Some(value) = actual {
        print("FAIL ${label}");
        print("  expected: None");
        print("  actual:   Some(${value})");
        exit(1);
    }
}

/// Expect one string to contain another, naming both sides on failure.
pub fn expect_contains_text(string haystack, string needle, string label) {
    if !haystack.contains(needle) {
        print("FAIL ${label}");
        print("  expected to contain: ${needle}");
        print("  actual: ${haystack}");
        exit(1);
    }
}
