// The CLI package: help text, flags, values, and positionals.
//
// A declaration is one newline-separated `name|description|kind` line, so
// no array of structs is needed. Errors are process exits with status 2 and
// generated usage on stderr; the main happy path is asserted here.

import cli;

fn declarations() -> string {
    return "quiet|run quietly|flag\noutput|write to this file|value";
}

fn main() {
    const help = cli.usage("example", declarations());
    assert(help.contains("--quiet"));
    assert(help.contains("--output"));
    assert(help.contains("--help"));

    let arguments = []string {};
    arguments.push("--quiet");
    arguments.push("--output");
    arguments.push("out.txt");
    arguments.push("input.txt");
    const parsed = cli.parse_arguments("example", declarations(), move arguments);
    const Parsed {
        flags: flag_values, values: value_values, positionals: positional_values, help: has_help
    }
    = parsed;
    assert(cli.has_flag(flag_values, "quiet"));
    const found = cli.value(value_values, "output");
    const output = switch found {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
    assert(output == "out.txt");
    const positional = cli.positional(positional_values, 0);
    const input = switch positional {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
    assert(input == "input.txt");
    assert(!has_help);
    print("cli-ok");
}
