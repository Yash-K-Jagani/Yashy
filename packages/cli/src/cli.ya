// Command-line arguments (phase 12, Task 7).
//
// `parse` reads the built-in `args()` list and turns it into a small parsed
// result. A declaration is one line of the form
// `name|description|kind`, where `kind` is `flag` or `value`; a program
// joins its declarations with newlines. One string, rather than an array of
// structs, keeps the declarations free of array-element ownership rules and
// matches how they are read in a README.
//
// `--help` is accepted by every parser; its text is generated in declaration
// order. A parse error writes one line and the generated usage to standard
// error and exits with status 2.

pub struct Parsed {
    pub flags: []string,
    pub values: []string,
    pub positionals: []string,
    pub help: bool,
}

pub fn usage(string program, string declarations) -> string {
    let text = "usage: ${program} [options] [operands]";
    let start = 0;
    while start < declarations.len() {
        let end = line_end(declarations, start);
        if end < 0 {
            break;
        }
        const line = declarations.slice(start, end);
        if !line.is_empty() {
            const name = declaration_name(line);
            const kind = declaration_kind(line);
            const description = declaration_description(line);
            if kind == "value" {
                text = text + "\n  --${name} <value>: ${description}";
            } else {
                text = text + "\n  --${name}: ${description}";
            }
        }
        start = end + 1;
    }
    text = text + "\n  --help: show this help";
    return text;
}

fn line_end(string text, int start) -> int {
    let index = start;
    while index < text.len() {
        if text.byte_at(index).to_int() == 10 {
            return index;
        }
        index = index + 1;
    }
    if start < text.len() {
        return text.len();
    }
    return -1;
}

fn declaration_description(string declaration) -> string {
    // `text` must own its bytes before `parts` is freed: a string read out
    // of a `[]string` aliases the slice's element, so freeing the slice
    // frees the field too. `slice` copies, which keeps the field alive.
    const parts = declaration.split("|");
    const text = switch parts[1] {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
    const owned = text.slice(0, text.len());
    parts.free();
    return owned;
}

fn declaration_kind(string declaration) -> string {
    const parts = declaration.split("|");
    const text = switch parts[2] {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
    const owned = text.slice(0, text.len());
    parts.free();
    return owned;
}

fn declaration_name(string declaration) -> string {
    const parts = declaration.split("|");
    const text = switch parts[0] {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
    const owned = text.slice(0, text.len());
    parts.free();
    return owned;
}

pub fn fail(string program, string declarations, string message) -> int {
    eprint("error: ${message}");
    eprint(usage(program, declarations));
    exit(2);
    return 2;
}

pub fn parse(string program, string declarations) -> Parsed {
    return parse_arguments(program, declarations, args());
}

pub fn parse_arguments(string program, string declarations, []string arguments) -> Parsed {
    let flags = []string {};
    let values = []string {};
    let positionals = []string {};
    let help = false;
    let end_of_flags = false;
    let index = 0;
    while index < arguments.len() {
        const argument = switch arguments[index] {
            case Some(value) {
                value
            }
            case None {
                ""
            }
        };
        if end_of_flags {
            positionals.push(argument);
            index = index + 1;
            continue;
        }
        if argument == "--" {
            end_of_flags = true;
            index = index + 1;
            continue;
        }
        if argument == "--help" || argument == "-h" {
            help = true;
            index = index + 1;
            continue;
        }
        if argument.starts_with("--") {
            const body = argument.slice(2, argument.len());
            let name = body;
            let value = "";
            const equals = body.index_of("=");
            const at = switch equals {
                case Some(found) {
                    found
                }
                case None {
                    -1
                }
            };
            if at >= 0 {
                name = body.slice(0, at);
                value = body.slice(at + 1, body.len());
            }
            let declaration = "";
            const declaration_index = find_declaration(declarations, name);
            if declaration_index < 0 {
                const near = suggest(declarations, name);
                if near.len() > 0 {
                    fail(program, declarations, "unknown option --${name}; did you mean --${near}?");
                }
                fail(program, declarations, "unknown option --${name}");
            }
            const declaration_line = declarations.slice(
            declaration_index,
            line_end(declarations, declaration_index)
            );
            declaration = declaration_line;
            if declaration_kind(declaration) == "value" {
                if at < 0 {
                    const next_index = index + 1;
                    if next_index >= arguments.len() {
                        fail(program, declarations, "--${name} needs a value");
                    }
                    value = switch arguments[next_index] {
                        case Some(next) {
                            next
                        }
                        case None {
                            ""
                        }
                    };
                    index = next_index;
                }
                values.push(name);
                values.push(value);
            } else {
                if at >= 0 && value != "true" && value != "false" {
                    fail(program, declarations, "--${name} is a flag and takes no value");
                }
                if at < 0 || value == "true" {
                    flags.push(name);
                }
            }
            index = index + 1;
            continue;
        }
        if argument.starts_with("-") && argument != "-" && !argument.starts_with("--") {
            // Short flags are bundled: `-abc` is `-a -b -c`. A declaration's
            // optional fourth field names its short letter.
            const letters = argument.slice(1, argument.len());
            let at = 0;
            while at < letters.len() {
                const letter = letters.byte_at(at);
                const long = short_name(declarations, letter);
                if long.len() == 0 {
                    fail(program, declarations, "unknown option -${letter}");
                }
                let bool present = false;
                let check = 0;
                while check < flags.len() {
                    const known = switch flags[check] {
                        case Some(value) {
                            value
                        }
                        case None {
                            ""
                        }
                    };
                    if known == long {
                        present = true;
                    }
                    check = check + 1;
                }
                if !present {
                    flags.push(long);
                }
                at = at + 1;
            }
            index = index + 1;
            continue;
        }
        positionals.push(argument);
        index = index + 1;
    }
    arguments.free();
    // Fifth field of a declaration names an environment variable used only
    // when the flag was absent on the command line: CLI > env > default.
    let start = 0;
    while start < declarations.len() {
        const end = line_end(declarations, start);
        const line = declarations.slice(start, end);
        const name = declaration_name(line);
        const env_name = declaration_field(line, 4);
        if env_name.len() > 0 {
            if declaration_kind(line) == "value" {
                let bool have_value = false;
                let vi = 0;
                while vi < values.len() {
                    const key = switch values[vi] {
                        case Some(v) {
                            v
                        }
                        case None {
                            ""
                        }
                    };
                    if key == name {
                        have_value = true;
                    }
                    vi = vi + 2;
                }
                if !have_value {
                    const found = getenv(env_name);
                    if let Some(text) = found {
                        values.push(name);
                        values.push(text);
                    }
                }
            } else {
                let bool have_flag = false;
                let fi = 0;
                while fi < flags.len() {
                    const key = switch flags[fi] {
                        case Some(v) {
                            v
                        }
                        case None {
                            ""
                        }
                    };
                    if key == name {
                        have_flag = true;
                    }
                    fi = fi + 1;
                }
                if !have_flag {
                    const found = getenv(env_name);
                    if let Some(text) = found {
                        if text == "true" || text == "1" {
                            flags.push(name);
                        }
                    }
                }
            }
        }
        start = end + 1;
    }
    // A sixth field names a required option. The declaration is the single
    // source of truth, so a missing required flag is a usage error here
    // rather than a check repeated at every call site.
    start = 0;
    while start < declarations.len() {
        const end = line_end(declarations, start);
        const line = declarations.slice(start, end);
        const required = declaration_field(line, 5);
        if required.len() > 0 {
            const name = declaration_name(line);
            let present = false;
            if declaration_kind(line) == "value" {
                let vi = 0;
                while vi < values.len() {
                    const key = switch values[vi] {
                        case Some(v) {
                            v
                        }
                        case None {
                            ""
                        }
                    };
                    if key == name {
                        present = true;
                    }
                    vi = vi + 2;
                }
            } else {
                for flag in flags {
                    if flag == name {
                        present = true;
                    }
                }
            }
            if !present {
                fail(program, declarations, "missing required --${name} (${required})");
            }
        }
        start = end + 1;
    }
    return Parsed {
        flags: move flags,
        values: move values,
        positionals: move positionals,
        help: help,
    };
}

/// The fourth field of a declaration line names its short flag letter.
fn declaration_field(string line, int wanted) -> string {
    let field = 0;
    let start = 0;
    let index = 0;
    while index <= line.len() {
        if index == line.len() || line.byte_at(index) == '|' {
            if field == wanted {
                return line.slice(start, index);
            }
            field = field + 1;
            start = index + 1;
        }
        index = index + 1;
    }
    return "";
}

/// Find the long name of a short letter, or "" when none is declared.
fn short_name(string declarations, char letter) -> string {
    let start = 0;
    while start < declarations.len() {
        const end = line_end(declarations, start);
        const line = declarations.slice(start, end);
        const short = declaration_field(line, 3);
        if short.len() > 0 && short.byte_at(0) == letter {
            return declaration_name(line);
        }
        start = end + 1;
    }
    return "";
}

/// The closest declared name to an unknown option, for a usage suggestion.
pub fn suggest(string declarations, string unknown) -> string {
    let best = "";
    let best_score = 0;
    let start = 0;
    while start < declarations.len() {
        const end = line_end(declarations, start);
        const name = declaration_name(declarations.slice(start, end));
        let score = 0;
        let index = 0;
        while index < name.len() && index < unknown.len() {
            if name.byte_at(index) == unknown.byte_at(index) {
                score = score + 1;
            }
            index = index + 1;
        }
        if score > best_score {
            best = name;
            best_score = score;
        }
        start = end + 1;
    }
    return best;
}

fn find_declaration(string declarations, string name) -> int {
    let start = 0;
    while start < declarations.len() {
        const end = line_end(declarations, start);
        const line = declarations.slice(start, end);
        if declaration_name(line) == name {
            return start;
        }
        start = end + 1;
    }
    return -1;
}

pub fn has_flag([]string flags, string name) -> bool {
    let found = false;
    for flag in flags {
        if flag == name {
            found = true;
        }
    }
    flags.free();
    return found;
}

pub fn value([]string values, string name) -> Option[string] {
    let previous = "";
    let awaiting_value = false;
    let Option[string] output = None;
    for found in values {
        if awaiting_value {
            if previous == name {
                output = Some(found);
            }
            awaiting_value = false;
            previous = "";
        } else {
            previous = found;
            awaiting_value = true;
        }
    }
    values.free();
    return output;
}

pub fn positional([]string positionals, int index) -> Option[string] {
    let Option[string] output = None;
    let current = 0;
    for value in positionals {
        if current == index {
            output = Some(value);
        }
        current = current + 1;
    }
    positionals.free();
    return output;
}
