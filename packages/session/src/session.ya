// Signed session tokens.
//
// A token is `payload.signature`, where the signature is a SHA-256 HMAC-shaped
// digest over `secret + "." + payload`, both base64url encoded. A verifier
// recomputes the digest and compares it in constant time, so a token whose
// payload was changed is `Option.None` rather than a partially trusted value.
// Nothing here encrypts: a session payload is visible to its holder by design.

import hash;
import text;
import string;

/// Compare two strings without an early exit on the first difference.
pub fn constant_time_eq(string left, string right) -> bool {
    let different = 0;
    let shorter = left.len();
    if right.len() < shorter {
        shorter = right.len();
    }
    let index = 0;
    while index < shorter {
        different = different | (left.byte_at(index).to_int() ^ right.byte_at(index).to_int());
        index = index + 1;
    }
    different = different | (left.len() ^ right.len());
    return different == 0;
}

/// The digest hex text for a secret and payload.
fn digest(string secret, string payload) -> string {
    const bytes = string.to_bytes(secret + "." + payload);
    const sum = hash.sha256(bytes);
    const hex = text.hex_encode(sum);
    sum.free();
    bytes.free();
    return hex;
}

/// Sign a payload, producing `payload.signature`.
pub fn sign(string secret, string payload) -> string {
    const signature = text.base64url_encode(string.to_bytes(digest(secret, payload)));
    return text.base64url_encode(string.to_bytes(payload)) + "." + signature;
}

/// Verify a token, returning its payload when the signature checks out.
pub fn verify(string secret, string token) -> Option[string] {
    const dot = token.index_of(".");
    const at = switch dot {
        case Some(index) { index }
        case None { return None; }
    };
    const encoded_payload = token.slice(0, at);
    const presented = token.slice(at + 1, token.len());
    const payload_bytes = switch text.base64url_decode(encoded_payload) {
        case Ok(bytes) { bytes }
        case Err(_) { return None; }
    };
    const payload = string.from_bytes(payload_bytes);
    const restored = switch payload {
        Ok(text_value) { text_value }
        Err(_) { return None; }
    };
    const expected = text.base64url_encode(string.to_bytes(digest(secret, restored)));
    if !constant_time_eq(presented, expected) {
        return None;
    }
    return Some(restored);
}
