// Read JSON-ish objects from standard input, one per line, and print a JSON
// summary. This is deliberately a line scanner rather than a full parser:
// Yashy's standard library has JSON text helpers, not a JSON value type.
//
// The `JSON.quote` call is the real module doing its job: the note is escaped
// as a JSON string literal, so the output is valid JSON even if the note later
// grows a quote or a newline.
//
// `read_line` answers `Option[string]`: `None` is end of input and `Some("")` is
// an empty line, so the loop stops on the first and counts the second.

import JSON;

fn key_of(string line) -> string {
    let open = -1;
    let index = 0;
    let length = line.len();

    while index < length {
        // 34 is the double quote in ASCII.
        if line.byte_at(index).to_int() == 34 {
            if open < 0 {
                open = index;
            } else {
                return line.slice(open + 1, index);
            }
        }
        index = index + 1;
    }
    return line.slice(0, 0);
}

/// Whether a line arrived.
fn present(Option[string] line) -> bool {
    return switch line {
        case Some(_) { true }
        case None { false }
    };
}

/// The text of a line that arrived.
fn text_of(Option[string] line) -> string {
    return switch line {
        case Some(value) { value }
        case None { "" }
    };
}

fn main() {
    let documents = 0;
    let map[string]int keys = map_new();

    let line = read_line();
    while present(line) {
        documents = documents + 1;
        let key = key_of(text_of(line));
        if key.len() > 0 {
            keys.insert(key, 1);
        }
        line = read_line();
    }

    let report = "{\"documents\": " + str_from_i64(documents) + ", \"distinct_keys\": " + str_from_i64(keys.len()) + ", \"note\": " + JSON.quote("counted by Yashy") + "}";
    print(report);

    keys.free();
}
