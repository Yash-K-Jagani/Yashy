// Lines, words, and bytes over standard input, in the shape of `wc`.
//
// `read_line` strips the terminator, so the byte count adds one per line for
// the newline it removed. The word half is `count_words` in `wc_words.ya`,
// found beside this file.
//
// `read_line` answers `Option[string]`: `None` is end of input and `Some("")` is
// an empty line, so the loop stops on the first and counts the second.

import wc_words;

/// Whether a line arrived.
fn present(Option[string] line) -> bool {
    return switch line {
        case Some(_) {
            true
        }
        case None {
            false
        }
    };
}

/// The text of a line that arrived.
fn text_of(Option[string] line) -> string {
    return switch line {
        case Some(value) {
            value
        }
        case None {
            ""
        }
    };
}

fn main() {
    let lines = 0;
    let words = 0;
    let bytes = 0;

    let line = read_line();
    while present(line) {
        const text = text_of(line);
        lines = lines + 1;
        words = words + count_words(text);
        bytes = bytes + text.len() + 1;
        line = read_line();
    }

    print(lines, words, bytes);
}
